<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Gösterim - 88ATSPEED</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: transparent; color: #fff; }
        .gosterim-controls {
            background: rgba(30, 30, 60, 0.8);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 20px;
            display: flex;
            gap: 15px;
            align-items: flex-end;
            flex-wrap: wrap;
        }
        .control-group { display: flex; flex-direction: column; gap: 8px; }
        .control-label { font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; color: #ff9800; }
        .gosterim-btn {
            padding: 12px 20px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 12px;
            cursor: pointer;
            background: linear-gradient(135deg, #ff9800, #f44336);
            color: white;
            min-width: 160px;
            border: none;
        }
        .gosterim-btn:hover { opacity: 0.9; transform: translateY(-2px); }
        .results-table {
            background: rgba(30, 30, 60, 0.6);
            border-radius: 20px;
            overflow-x: auto;
            padding: 15px;
        }
        table { width: 100%; border-collapse: collapse; font-size: 10px; }
        th, td { padding: 6px 8px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.1); border-right: 1px solid rgba(255,255,255,0.05); }
        th { background: rgba(0,0,0,0.4); color: #ff9800; font-weight: 600; position: sticky; top: 0; white-space: nowrap; }
        .status { padding: 12px; border-radius: 12px; margin-bottom: 15px; text-align: center; }
        .status-loading { background: rgba(255,152,0,0.2); color: #ff9800; }
        .status-success { background: rgba(76,175,80,0.2); color: #4CAF50; }
        .status-error { background: rgba(244,67,54,0.2); color: #f44336; }
        .empty { text-align: center; padding: 60px; color: rgba(255,255,255,0.5); }
        .race-card { background: rgba(30,30,60,0.4); border-radius: 16px; margin-bottom: 20px; overflow: hidden; }
        .race-header { background: linear-gradient(135deg, rgba(255,152,0,0.2), rgba(76,175,80,0.1)); padding: 10px 15px; font-weight: bold; font-size: 14px; }
        .kayit-listesi {
            background: rgba(0,0,0,0.3);
            border-radius: 12px;
            padding: 10px;
            margin-bottom: 15px;
            max-height: 250px;
            overflow-y: auto;
        }
        .kayit-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 12px;
            margin: 5px 0;
            background: rgba(255,255,255,0.05);
            border-radius: 8px;
            cursor: pointer;
        }
        .kayit-item:hover { background: rgba(255,152,0,0.2); }
        .sari-hucre { background-color: #ffeb3b !important; color: #000 !important; font-weight: bold; }
    </style>
</head>
<body>
<div id="gosterimContainer">
<div class="gosterim-controls">
<div class="control-group"><button id="kayitlariGetirBtn" class="gosterim-btn">📋 HESAPLAMA KAYITLARI</button></div>
</div>
<div id="kayitListesi" class="kayit-listesi" style="display:none;"></div>
<div id="gosterimStatus"></div>
<div id="gosterimResults" class="results-table"><div class="empty">🏇 HESAPLAMA KAYITLARI butonuna tıklayın</div></div>
</div>

<script>
let currentHesaplamaData = null;
let currentHesaplamaId = null;

function dereceToSalise(derece) {
    if (!derece || derece === '-' || derece === 'Derecesiz') return null;
    try {
        let s = derece.toString().trim().replace(/:/g, '.');
        let parts = s.split('.');
        if (parts.length === 3) {
            return (parseInt(parts[0]) * 60 * 100) + (parseInt(parts[1]) * 100) + parseInt(parts[2]);
        } else if (parts.length === 2) {
            return (parseInt(parts[0]) * 100) + parseInt(parts[1]);
        } else if (parts.length === 1) {
            return parseInt(parts[0]) * 100;
        }
    } catch(e) { return null; }
    return null;
}

function saliseToDerece(salise) {
    if (!salise) return '-';
    try {
        let salise_int = Math.floor(Math.abs(salise));
        let dk = Math.floor(salise_int / 6000);
        let kalan = salise_int % 6000;
        let sn = Math.floor(kalan / 100);
        let sl = kalan % 100;
        if (dk > 0) return `${dk}.${sn.toString().padStart(2,'0')}.${sl.toString().padStart(2,'0')}`;
        else return `${sn.toString().padStart(2,'0')}.${sl.toString().padStart(2,'0')}`;
    } catch(e) { return '-'; }
}

function saliseToFarkFormat(salise) {
    if (!salise) return '-';
    let abs_salise = Math.abs(parseInt(salise));
    let sn = Math.floor(abs_salise / 100);
    let sl = abs_salise % 100;
    let sign = salise >= 0 ? '+' : '-';
    return `${sign}${sn.toString().padStart(2,'0')}.${sl.toString().padStart(2,'0')}`;
}

function metreBasiSalise(salise, mesafe) {
    if (salise && mesafe && mesafe !== '-' && mesafe !== 'Derecesiz') {
        return salise / parseInt(mesafe);
    }
    return null;
}

function son800MetreBasiSalise(son800) {
    if (!son800 || son800 === '-') return null;
    let salise = dereceToSalise(son800);
    if (salise) return salise / 800;
    return null;
}

document.getElementById('kayitlariGetirBtn').onclick = async () => {
    const statusDiv = document.getElementById('gosterimStatus');
    const kayitListesiDiv = document.getElementById('kayitListesi');
    
    statusDiv.innerHTML = '<div class="status status-loading">⏳ Hesaplama kayıtları yükleniyor...</div>';
    
    try {
        const response = await fetch('/api/hesaplama-kayitlar');
        const result = await response.json();
        
        if (!result.success) throw new Error(result.error);
        
        if (result.kayitlar.length === 0) {
            kayitListesiDiv.innerHTML = '<div class="empty">⚠️ Hiç hesaplama kaydı bulunamadı</div>';
            kayitListesiDiv.style.display = 'block';
            statusDiv.innerHTML = '<div class="status status-error">⚠️ Hiç kayıt yok</div>';
            return;
        }
        
        let html = '<div style="margin-bottom:10px; font-weight:bold;">📋 HESAPLAMA KAYITLARI:</div>';
        for (let i = 0; i < result.kayitlar.length; i++) {
            const k = result.kayitlar[i];
            html += `<div class="kayit-item" data-id="${k.id}">
                        <span>📅 ${k.tarih} | 🏟️ ${k.hipodrom} | 🐎 ${k.total_horses} at | 🕐 ${k.kayit_tarihi}</span>
                        <span style="color:#ff9800;">📂 Yükle →</span>
                    </div>`;
        }
        kayitListesiDiv.innerHTML = html;
        kayitListesiDiv.style.display = 'block';
        
        document.querySelectorAll('.kayit-item').forEach(item => {
            item.onclick = async () => {
                const id = item.dataset.id;
                await loadKayit(id);
                kayitListesiDiv.style.display = 'none';
            };
        });
        
        statusDiv.innerHTML = '<div class="status status-success">✅ ' + result.kayitlar.length + ' kayıt bulundu</div>';
        
    } catch (error) {
        statusDiv.innerHTML = '<div class="status status-error">❌ Hata: ' + error.message + '</div>';
    }
};

async function loadKayit(id) {
    const statusDiv = document.getElementById('gosterimStatus');
    statusDiv.innerHTML = '<div class="status status-loading">⏳ Kayıt yükleniyor...</div>';
    
    try {
        const response = await fetch('/api/hesaplama-kayit/' + id);
        const result = await response.json();
        
        if (!result.success) throw new Error(result.error);
        
        currentHesaplamaData = result.kayit.veri;
        currentHesaplamaId = id;
        
        displayResults(currentHesaplamaData);
        statusDiv.innerHTML = '<div class="status status-success">✅ Kayıt yüklendi! (ID: ' + id + ')</div>';
        
    } catch (error) {
        statusDiv.innerHTML = '<div class="status status-error">❌ Yükleme hatası: ' + error.message + '</div>';
    }
}

function displayResults(data) {
    if (!data || data.length === 0) {
        document.getElementById('gosterimResults').innerHTML = '<div class="empty">⚠️ Veri bulunamadı</div>';
        return;
    }
    
    let html = '';
    
    for (let i = 0; i < data.length; i++) {
        const race = data[i];
        
        html += `<div class="race-card">`;
        html += `<div class="race-header">🏆 ${race.raceNo}. KOŞU (${race.horses.length} at)</div>`;
        html += `<div style="overflow-x:auto;">`;
        html += `<table border="0">`;
        html += `<thead><tr>`;
        html += `<th>SIRA</th><th>AT İSMİ</th><th>AT ID</th>`;
        html += `<th>TARİH</th><th>ŞEHİR</th><th>MESAFE</th><th>SIRA</th><th>AT DERECE</th><th>1.DERECE</th><th>SON800-1</th><th>SON800-2</th>`;
        html += `<th>DR/SL</th><th>1DR/SL</th><th>FARK</th><th>8001/SL</th><th>8002/SL</th><th>8002-8001</th>`;
        html += `<th>TEST1</th><th>TEST2</th><th>TEST3</th><th>TEST4</th><th>TEST5</th><th>TEST6</th><th>TEST7</th><th>TEST8</th>`;
        html += `</thead><tbody>`;
        
        for (let j = 0; j < race.horses.length; j++) {
            const horse = race.horses[j];
            const kosular = horse.kosular || [];
            
            for (let idx = 0; idx < kosular.length; idx++) {
                const atKosu = kosular[idx];
                
                const mesafe = atKosu.mesafe;
                const dereceStr = atKosu.at_derece;
                const birinciDerece = atKosu.birinci_derece;
                let son800_1 = atKosu.son800_bir;
                let son800_2 = atKosu.son800_iki;
                if (!son800_2 || son800_2 === '-') son800_2 = son800_1;
                
                const dereceSalise = dereceToSalise(dereceStr);
                const birinciSalise = dereceToSalise(birinciDerece);
                const son800_1Salise = dereceToSalise(son800_1);
                const son800_2Salise = dereceToSalise(son800_2);
                
                const dr_sl = metreBasiSalise(dereceSalise, mesafe);
                const birinci_dr_sl = metreBasiSalise(birinciSalise, mesafe);
                const son800_1_sl = son800_1Salise ? son800_1Salise / 800 : null;
                const son800_2_sl = son800_2Salise ? son800_2Salise / 800 : null;
                
                const fark = (birinci_dr_sl && dr_sl) ? (birinci_dr_sl - dr_sl) : null;
                const fark_8002_8001 = (son800_2_sl && son800_1_sl) ? (son800_2_sl - son800_1_sl) : null;
                
                // TEST hesaplamaları (koşu mesafesi ile)
                let test1_salise = null, test2_salise = null, test3_salise = null;
                if (dr_sl && mesafe && mesafe !== '-') {
                    test1_salise = parseInt(mesafe) * dr_sl;
                }
                if (son800_1_sl && mesafe && mesafe !== '-') {
                    test2_salise = parseInt(mesafe) * son800_1_sl;
                }
                if (son800_2_sl && mesafe && mesafe !== '-') {
                    test3_salise = parseInt(mesafe) * son800_2_sl;
                }
                
                let test4_salise = null, test6_salise = null, test7_salise = null;
                if (test1_salise && test3_salise) test4_salise = test3_salise - test1_salise;
                if (test1_salise && test2_salise) test6_salise = test2_salise - test1_salise;
                if (test2_salise && test3_salise) test7_salise = test3_salise - test2_salise;
                
                let test8_deger = null;
                if (test1_salise && test2_salise && test2_salise !== 0) test8_deger = (test1_salise / test2_salise) * 100;
                
                // TEST4 ve TEST6 eşit mi kontrolü
                let ayniMi = (test4_salise !== null && test6_salise !== null && test4_salise === test6_salise);
                let satirClass = ayniMi ? 'class="sari-satir"' : '';
                let test4Class = ayniMi ? 'class="sari-hucre"' : '';
                let test6Class = ayniMi ? 'class="sari-hucre"' : '';
                
                html += `<tr>`;
                html += `<td>${idx+1}</td>`;
                html += `<td>${escapeHtml(horse.name || '-')}</td>`;
                html += `<td>${horse.atId || '-'}</td>`;
                html += `<td>${atKosu.tarih || '-'}</td>`;
                html += `<td>${atKosu.sehir || '-'}</td>`;
                html += `<td>${mesafe || '-'}</td>`;
                html += `<td>${atKosu.sira || '-'}</td>`;
                html += `<td>${dereceStr || '-'}</td>`;
                html += `<td>${birinciDerece || '-'}</td>`;
                html += `<td>${son800_1 || '-'}</td>`;
                html += `<td>${son800_2 || '-'}</td>`;
                html += `<td>${dr_sl ? dr_sl.toFixed(4) : '-'}</td>`;
                html += `<td>${birinci_dr_sl ? birinci_dr_sl.toFixed(4) : '-'}</td>`;
                html += `<td>${fark ? (fark > 0 ? '+' : '') + fark.toFixed(4) : '-'}</td>`;
                html += `<td>${son800_1_sl ? son800_1_sl.toFixed(4) : '-'}</td>`;
                html += `<td>${son800_2_sl ? son800_2_sl.toFixed(4) : '-'}</td>`;
                html += `<td>${fark_8002_8001 ? (fark_8002_8001 > 0 ? '+' : '') + fark_8002_8001.toFixed(4) : '-'}</td>`;
                html += `<td>${test1_salise ? saliseToDerece(test1_salise) : '-'}</td>`;
                html += `<td>${test2_salise ? saliseToDerece(test2_salise) : '-'}</td>`;
                html += `<td>${test3_salise ? saliseToDerece(test3_salise) : '-'}</td>`;
                html += `<td ${test4Class}>${test4_salise ? saliseToFarkFormat(test4_salise) : '-'}</td>`;
                html += `<td>-</td>`;
                html += `<td ${test6Class}>${test6_salise ? saliseToFarkFormat(test6_salise) : '-'}</td>`;
                html += `<td>${test7_salise ? saliseToFarkFormat(test7_salise) : '-'}</td>`;
                html += `<td>${test8_deger ? test8_deger.toFixed(2) + '%' : '-'}</td>`;
                html += `</tr>`;
            }
        }
        
        html += `</tbody></table></div></div><br>`;
    }
    
    document.getElementById('gosterimResults').innerHTML = html;
}

function escapeHtml(s) {
    if (!s) return '-';
    return String(s).replace(/[&<>]/g, function(m) {
        return m === '&' ? '&amp;' : m === '<' ? '&lt;' : '&gt;';
    });
}
</script>
</body>
</html>
