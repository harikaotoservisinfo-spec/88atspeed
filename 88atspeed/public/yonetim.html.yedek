<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Yönetim - 88ATSPEED</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: transparent;
            color: #fff;
        }
        .yonetim-controls {
            background: rgba(30, 30, 60, 0.8);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 20px;
            display: flex;
            gap: 15px;
            align-items: flex-end;
            flex-wrap: wrap;
        }
        .control-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .control-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 700;
            color: #ff9800;
        }
        .yonetim-btn {
            padding: 12px 20px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 12px;
            cursor: pointer;
            background: linear-gradient(135deg, #ff9800, #f44336);
            color: white;
            min-width: 160px;
            border: none;
        }
        .yonetim-btn:hover { opacity: 0.9; transform: translateY(-2px); }
        .save-btn { background: linear-gradient(135deg, #2196F3, #1976D2); }
        .excel-btn { background: linear-gradient(135deg, #4CAF50, #2E7D32); }
        .upload-btn { background: linear-gradient(135deg, #9C27B0, #6A1B9A); }
        .results-table {
            background: rgba(30, 30, 60, 0.6);
            border-radius: 20px;
            overflow-x: auto;
            padding: 15px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }
        th, td {
            padding: 6px 8px;
            text-align: left;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            border-right: 1px solid rgba(255,255,255,0.05);
            vertical-align: top;
        }
        th {
            background: rgba(0,0,0,0.4);
            color: #ff9800;
            font-weight: 600;
            position: sticky;
            top: 0;
        }
        td input, td select {
            background: #1a1a3e;
            border: 1px solid #ff9800;
            color: white;
            padding: 4px 6px;
            border-radius: 6px;
            width: 100%;
            font-size: 11px;
        }
        .formula-input {
            background: #1a1a3e;
            border: 1px solid #4CAF50;
            color: #4CAF50;
            font-family: monospace;
        }
        .col-formula-input {
            background: #0a2a4a;
            border: 1px solid #ff9800;
            color: #ff9800;
            font-family: monospace;
            font-size: 10px;
            width: 100%;
            text-align: center;
        }
        .status {
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 15px;
            text-align: center;
        }
        .status-loading { background: rgba(255,152,0,0.2); color: #ff9800; }
        .status-success { background: rgba(76,175,80,0.2); color: #4CAF50; }
        .status-error { background: rgba(244,67,54,0.2); color: #f44336; }
        .empty { text-align: center; padding: 60px; color: rgba(255,255,255,0.5); }
        .kayit-listesi {
            background: rgba(0,0,0,0.3);
            border-radius: 12px;
            padding: 10px;
            margin-bottom: 15px;
            max-height: 200px;
            overflow-y: auto;
        }
        .kayit-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 12px;
            margin: 3px 0;
            background: rgba(255,255,255,0.05);
            border-radius: 8px;
            cursor: pointer;
            font-size: 12px;
        }
        .kayit-item:hover { background: rgba(255,152,0,0.2); }
        .kayit-item.selected { background: rgba(255,152,0,0.4); }
        .race-card {
            background: rgba(30, 30, 60, 0.4);
            border-radius: 16px;
            margin-bottom: 20px;
            overflow: hidden;
        }
        .race-header {
            background: linear-gradient(135deg, rgba(255,152,0,0.2), rgba(76,175,80,0.1));
            padding: 10px 15px;
            font-weight: bold;
            font-size: 14px;
        }
        .add-col-btn {
            background: #4CAF50;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 11px;
            margin-left: 10px;
        }
        .delete-col-btn {
            background: #f44336;
            color: white;
            border: none;
            padding: 2px 6px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 10px;
            margin-left: 5px;
        }
        .modal {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: #1a1a3e;
            padding: 20px;
            border-radius: 12px;
            z-index: 1000;
            display: none;
            min-width: 400px;
        }
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 999;
            display: none;
        }
        .formula-help {
            font-size: 10px;
            color: #aaa;
            margin-top: 5px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .formula-tag {
            background: #0a2a4a;
            padding: 2px 6px;
            border-radius: 4px;
            cursor: pointer;
        }
        .formula-tag:hover { background: #ff9800; color: #000; }
        .excel-buttons {
            display: flex;
            gap: 10px;
        }
        .file-input {
            display: none;
        }
    </style>
</head>
<body>
    <div id="yonetimContainer">
        <div class="yonetim-controls">
            <div class="control-group">
                <div class="control-label">📋 KARŞILAŞTIRMA KAYDI</div>
                <button id="karsilastirmaKayitlariBtn" class="yonetim-btn">KARŞILAŞTIRMA KAYITLARI</button>
            </div>
            <div class="control-group">
                <div class="control-label">📊 HESAPLAMA KAYDI</div>
                <button id="hesaplamaKayitlariBtn" class="yonetim-btn">HESAPLAMA KAYITLARI</button>
            </div>
            <div class="control-group">
                <div class="control-label">💾 ÇALIŞMAYI KAYDET</div>
                <button id="calismayiKaydetBtn" class="yonetim-btn save-btn">KAYDET</button>
            </div>
            <div class="control-group">
                <div class="control-label">📂 ÇALIŞMALARIM</div>
                <button id="calismalariGetirBtn" class="yonetim-btn">KAYITLI ÇALIŞMALAR</button>
            </div>
            <div class="excel-buttons">
                <div class="control-group">
                    <div class="control-label">📊 EXCEL AKTAR</div>
                    <button id="csvIndirBtn" class="yonetim-btn excel-btn">CSV İNDİR</button>
                </div>
                <div class="control-group">
                    <div class="control-label">📗 EXCEL AKTAR</div>
                    <button id="excelIndirBtn" class="yonetim-btn excel-btn">EXCEL İNDİR</button>
                </div>
                <div class="control-group">
                    <div class="control-label">📂 EXCEL YÜKLE</div>
                    <button id="excelYukleBtn" class="yonetim-btn upload-btn">EXCEL YÜKLE</button>
                    <input type="file" id="excelFileInput" class="file-input" accept=".csv,.xlsx,.xls">
                </div>
            </div>
        </div>
        
        <div id="kayitListesi" class="kayit-listesi" style="display:none;"></div>
        <div id="calismaListesi" class="kayit-listesi" style="display:none;"></div>
        <div id="yonetimStatus"></div>
        <div id="yonetimResults" class="results-table">
            <div class="empty">🏇 Önce KARŞILAŞTIRMA ve HESAPLAMA kayıtlarını seçin veya EXCEL YÜKLE ile dosya yükleyin</div>
        </div>
    </div>
    
    <div id="saveModal" class="modal-overlay"></div>
    <div id="saveModalContent" class="modal">
        <h3 style="margin-bottom:15px;">💾 Çalışmayı Kaydet</h3>
        <div class="control-group" style="margin-bottom:15px;">
            <div class="control-label">ÇALIŞMA ADI</div>
            <input type="text" id="calismaAdi" style="padding:8px; border-radius:8px; background:#0f3460; color:white; border:none; width:100%;">
        </div>
        <div class="control-group" style="margin-bottom:15px;">
            <div class="control-label">AÇIKLAMA</div>
            <textarea id="calismaAciklama" rows="3" style="padding:8px; border-radius:8px; background:#0f3460; color:white; border:none; width:100%;"></textarea>
        </div>
        <div style="display:flex; gap:10px; justify-content:flex-end;">
            <button id="saveModalClose" style="padding:8px 20px; border-radius:8px; background:#555; color:white; border:none;">İPTAL</button>
            <button id="saveModalConfirm" style="padding:8px 20px; border-radius:8px; background:#4CAF50; color:white; border:none;">KAYDET</button>
        </div>
    </div>

    <script>
        let currentKarsilastirmaData = null;
        let currentHesaplamaData = null;
        let currentKarsilastirmaId = null;
        let currentHesaplamaId = null;
        let sutunlar = ['SIRA', 'AT İSMİ', 'AT ID'];
        let hesaplamaKolons = [];
        let ekSutunlar = [];
        let sutunFormulleri = {};
        
        function renk(r, g, b) {
            return `rgb(${r}, ${g}, ${b})`;
        }
        
        function dereceToSayi(derece) {
            if (!derece) return null;
            const str = derece.toString();
            const parts = str.split('.');
            if (parts.length === 3) {
                return parseInt(parts[0]) * 60 + parseInt(parts[1]) + parseInt(parts[2]) / 100;
            } else if (parts.length === 2) {
                return parseInt(parts[0]) * 60 + parseInt(parts[1]);
            } else {
                return parseFloat(derece);
            }
        }
        
        function getColumnValues(colName, raceIndex) {
            const values = [];
            if (!currentKarsilastirmaData) return values;
            const race = currentKarsilastirmaData[raceIndex];
            if (!race) return values;
            
            const colIndex = ekSutunlar.indexOf(colName);
            if (colIndex === -1) return values;
            
            for (let j = 0; j < race.horses.length; j++) {
                const input = document.querySelector(`input[data-race="${raceIndex}"][data-horse="${j}"][data-col="ek_${colIndex}"]`);
                if (input && input.value) {
                    const val = dereceToSayi(input.value);
                    if (val !== null) values.push({ val, input, j });
                }
            }
            return values;
        }
        
        function applyColumnFormatting(colName, raceIndex) {
            const formula = sutunFormulleri[colName];
            if (!formula || !formula.startsWith('=')) return;
            
            const expr = formula.substring(1).toUpperCase();
            const values = getColumnValues(colName, raceIndex);
            if (values.length === 0) return;
            
            if (expr === 'MIN_MAX(' + colName + ')') {
                const minVal = Math.min(...values.map(v => v.val));
                const maxVal = Math.max(...values.map(v => v.val));
                values.forEach(v => {
                    if (v.val === minVal) {
                        v.input.style.backgroundColor = '#00ff00';
                        v.input.style.color = '#000';
                    } else if (v.val === maxVal) {
                        v.input.style.backgroundColor = '#ff0000';
                        v.input.style.color = '#fff';
                    } else {
                        v.input.style.backgroundColor = '#1a1a3e';
                        v.input.style.color = 'white';
                    }
                });
            }
            else if (expr === 'MIN(' + colName + ')') {
                const minVal = Math.min(...values.map(v => v.val));
                values.forEach(v => {
                    if (v.val === minVal) {
                        v.input.style.backgroundColor = '#00ff00';
                        v.input.style.color = '#000';
                    } else {
                        v.input.style.backgroundColor = '#1a1a3e';
                        v.input.style.color = 'white';
                    }
                });
            }
            else if (expr === 'MAX(' + colName + ')') {
                const maxVal = Math.max(...values.map(v => v.val));
                values.forEach(v => {
                    if (v.val === maxVal) {
                        v.input.style.backgroundColor = '#ff0000';
                        v.input.style.color = '#fff';
                    } else {
                        v.input.style.backgroundColor = '#1a1a3e';
                        v.input.style.color = 'white';
                    }
                });
            }
            else if (expr.startsWith('ESIK(')) {
                const match = expr.match(/ESIK\(([\d\.]+);\s*RENK\((\d+);(\d+);(\d+)\)\)/);
                if (match) {
                    const esik = parseFloat(match[1]);
                    const r = parseInt(match[2]);
                    const g = parseInt(match[3]);
                    const b = parseInt(match[4]);
                    values.forEach(v => {
                        if (v.val > esik) {
                            v.input.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;
                            v.input.style.color = '#fff';
                        } else {
                            v.input.style.backgroundColor = '#1a1a3e';
                            v.input.style.color = 'white';
                        }
                    });
                }
            }
        }
        
        function applyAllFormatting() {
            if (!currentKarsilastirmaData) return;
            for (let i = 0; i < currentKarsilastirmaData.length; i++) {
                for (let s of ekSutunlar) {
                    applyColumnFormatting(s, i);
                }
            }
        }
        
        function getAtHesaplamaVerisi(atId, kosuIndex, field) {
            if (!currentHesaplamaData) return '';
            for (let race of currentHesaplamaData) {
                for (let horse of race.horses) {
                    if (horse.atId == atId && horse.kosular && horse.kosular[kosuIndex]) {
                        return horse.kosular[kosuIndex][field] || '-';
                    }
                }
            }
            return '-';
        }
        
        function collectTableData() {
            if (!currentKarsilastirmaData) return [];
            
            const allColumns = [...sutunlar, ...hesaplamaKolons, ...ekSutunlar];
            const data = [];
            data.push(allColumns);
            
            for (let i = 0; i < currentKarsilastirmaData.length; i++) {
                const race = currentKarsilastirmaData[i];
                for (let j = 0; j < race.horses.length; j++) {
                    const horse = race.horses[j];
                    const row = [];
                    row.push(horse.sira);
                    row.push(horse.atIsmi);
                    row.push(horse.atId);
                    
                    for (let h = 0; h < hesaplamaKolons.length; h++) {
                        const kolonAdi = hesaplamaKolons[h];
                        let deger = '';
                        if (kolonAdi.includes('TARİH')) {
                            const kosuIndex = parseInt(kolonAdi.split('-')[0].substring(1)) - 1;
                            deger = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'tarih');
                        } else if (kolonAdi.includes('MESAFE')) {
                            const kosuIndex = parseInt(kolonAdi.split('-')[0].substring(1)) - 1;
                            deger = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'mesafe');
                        } else if (kolonAdi.includes('DERECE')) {
                            const kosuIndex = parseInt(kolonAdi.split('-')[0].substring(1)) - 1;
                            deger = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'at_derece');
                        } else if (kolonAdi.includes('SON800-1')) {
                            const kosuIndex = parseInt(kolonAdi.split('-')[0].substring(1)) - 1;
                            deger = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'son800_bir');
                        } else if (kolonAdi.includes('SON800-2')) {
                            const kosuIndex = parseInt(kolonAdi.split('-')[0].substring(1)) - 1;
                            deger = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'son800_iki');
                        }
                        row.push(deger);
                    }
                    
                    for (let e = 0; e < ekSutunlar.length; e++) {
                        const input = document.querySelector(`input[data-race="${i}"][data-horse="${j}"][data-col="ek_${e}"]`);
                        row.push(input ? input.value : '');
                    }
                    data.push(row);
                }
            }
            return data;
        }
        
        function downloadCSV() {
            const data = collectTableData();
            if (data.length === 0) {
                document.getElementById('yonetimStatus').innerHTML = '<div class="status status-error">❌ Önce bir tablo oluşturun!</div>';
                return;
            }
            
            let csvContent = data.map(row => 
                row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(',')
            ).join('\n');
            
            const blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            link.href = url;
            link.setAttribute('download', '88atspeed_veriler.csv');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
            
            document.getElementById('yonetimStatus').innerHTML = '<div class="status status-success">✅ CSV dosyası indirildi!</div>';
        }
        
        async function downloadExcel() {
            const data = collectTableData();
            if (data.length === 0) {
                document.getElementById('yonetimStatus').innerHTML = '<div class="status status-error">❌ Önce bir tablo oluşturun!</div>';
                return;
            }
            
            document.getElementById('yonetimStatus').innerHTML = '<div class="status status-loading">⏳ Excel dosyası hazırlanıyor...</div>';
            
            try {
                const response = await fetch('/api/excel-export', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ data: data, baslik: '88ATSPEED Verileri' })
                });
                
                const result = await response.json();
                if (result.success) {
                    const link = document.createElement('a');
                    link.href = result.url;
                    link.download = '88atspeed_veriler.xlsx';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    document.getElementById('yonetimStatus').innerHTML = '<div class="status status-success">✅ Excel dosyası indirildi!</div>';
                } else {
                    throw new Error(result.error);
                }
            } catch (error) {
                document.getElementById('yonetimStatus').innerHTML = '<div class="status status-error">❌ Excel hatası: ' + error.message + '</div>';
            }
        }
        
        // Excel Yükle
        function uploadExcel(file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const data = e.target.result;
                const workbook = XLSX.read(data, { type: 'binary' });
                const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                const rows = XLSX.utils.sheet_to_json(firstSheet, { header: 1, defval: '' });
                
                if (!rows || rows.length < 2) {
                    document.getElementById('yonetimStatus').innerHTML = '<div class="status status-error">❌ Dosyada veri bulunamadı!</div>';
                    return;
                }
                
                // Başlıkları al
                const headers = rows[0];
                
                // Veriyi currentKarsilastirmaData formatına çevir
                // Basit bir yapı: Tek bir koşu olarak değerlendir
                currentKarsilastirmaData = [{
                    raceNo: "1",
                    horseCount: rows.length - 1,
                    horses: []
                }];
                
                for (let i = 1; i < rows.length; i++) {
                    const row = rows[i];
                    if (row.length >= 3) {
                        currentKarsilastirmaData[0].horses.push({
                            sira: row[0] || i,
                            atIsmi: row[1] || 'Bilinmiyor',
                            atId: row[2] || '-'
                        });
                    }
                }
                
                // Ek sütunları ayarla
                ekSutunlar = [];
                for (let c = 3; c < headers.length; c++) {
                    if (headers[c] && headers[c].toString().trim()) {
                        ekSutunlar.push(headers[c].toString());
                    }
                }
                
                document.getElementById('yonetimStatus').innerHTML = '<div class="status status-success">✅ Excel dosyası yüklendi! ' + (rows.length - 1) + ' at bulundu.</div>';
                buildTable();
            };
            reader.readAsBinaryString(file);
        }
        
        document.getElementById('karsilastirmaKayitlariBtn').onclick = async () => {
            await listKayitlar('/api/karsilastirma-kayitlar', 'karsilastirma');
        };
        
        document.getElementById('hesaplamaKayitlariBtn').onclick = async () => {
            await listKayitlar('/api/hesaplama-kayitlar', 'hesaplama');
        };
        
        document.getElementById('csvIndirBtn').onclick = downloadCSV;
        document.getElementById('excelIndirBtn').onclick = downloadExcel;
        
        // Excel Yükle butonu
        document.getElementById('excelYukleBtn').onclick = () => {
            document.getElementById('excelFileInput').click();
        };
        
        document.getElementById('excelFileInput').onchange = (e) => {
            if (e.target.files && e.target.files[0]) {
                uploadExcel(e.target.files[0]);
            }
        };
        
        async function listKayitlar(apiUrl, tur) {
            const statusDiv = document.getElementById('yonetimStatus');
            const kayitListesiDiv = document.getElementById('kayitListesi');
            statusDiv.innerHTML = '<div class="status status-loading">⏳ Kayıtlar yükleniyor...</div>';
            
            try {
                const response = await fetch(apiUrl);
                const result = await response.json();
                if (!result.success) throw new Error(result.error);
                const kayitlar = result.kayitlar || result.calismalar || [];
                if (kayitlar.length === 0) {
                    kayitListesiDiv.innerHTML = '<div class="empty">⚠️ Hiç kayıt bulunamadı</div>';
                    kayitListesiDiv.style.display = 'block';
                    statusDiv.innerHTML = '<div class="status status-error">⚠️ Hiç kayıt yok</div>';
                    return;
                }
                let html = `<div style="margin-bottom:10px; font-weight:bold;">📋 ${tur.toUpperCase()} KAYITLARI:</div>`;
                for (let i = 0; i < kayitlar.length; i++) {
                    const k = kayitlar[i];
                    const kayitAdi = k.ad || `${k.tarih} - ${k.hipodrom}`;
                    html += `<div class="kayit-item" data-id="${k.id}" data-tur="${tur}" data-adi="${kayitAdi}">
                        <span>📅 ${kayitAdi} | 🕐 ${k.kayit_tarihi}</span>
                        <span style="color:#ff9800;">📂 Seç →</span>
                    </div>`;
                }
                kayitListesiDiv.innerHTML = html;
                kayitListesiDiv.style.display = 'block';
                document.getElementById('calismaListesi').style.display = 'none';
                
                document.querySelectorAll('.kayit-item').forEach(item => {
                    item.onclick = async () => {
                        const id = item.dataset.id;
                        const tur2 = item.dataset.tur;
                        const adi = item.dataset.adi;
                        document.querySelectorAll('.kayit-item').forEach(i => i.classList.remove('selected'));
                        item.classList.add('selected');
                        await loadKayit(id, tur2, adi);
                    };
                });
                statusDiv.innerHTML = '<div class="status status-success">✅ ' + kayitlar.length + ' kayıt bulundu.</div>';
            } catch (error) {
                statusDiv.innerHTML = '<div class="status status-error">❌ Hata: ' + error.message + '</div>';
            }
        }
        
        async function loadKayit(id, tur, adi) {
            const statusDiv = document.getElementById('yonetimStatus');
            statusDiv.innerHTML = '<div class="status status-loading">⏳ ' + tur + ' kaydı yükleniyor...</div>';
            try {
                if (tur === 'karsilastirma') {
                    const response = await fetch('/api/karsilastirma-kayit/' + id);
                    const result = await response.json();
                    if (result.success) {
                        currentKarsilastirmaData = result.kayit.siralama_veri;
                        currentKarsilastirmaId = id;
                        statusDiv.innerHTML = '<div class="status status-success">✅ KARŞILAŞTIRMA kaydı yüklendi!</div>';
                    }
                } else if (tur === 'hesaplama') {
                    const response = await fetch('/api/hesaplama-kayit/' + id);
                    const result = await response.json();
                    if (result.success) {
                        currentHesaplamaData = result.kayit.veri;
                        currentHesaplamaId = id;
                        if (currentHesaplamaData && currentHesaplamaData.length > 0) {
                            for (let race of currentHesaplamaData) {
                                if (race.horses && race.horses.length > 0) {
                                    const ilkAt = race.horses[0];
                                    if (ilkAt.kosular) {
                                        const kosuSayisi = ilkAt.kosular.length;
                                        hesaplamaKolons = [];
                                        for (let i = 1; i <= kosuSayisi; i++) {
                                            hesaplamaKolons.push(`K${i}-TARİH`, `K${i}-MESAFE`, `K${i}-DERECE`, `K${i}-SON800-1`, `K${i}-SON800-2`);
                                        }
                                        break;
                                    }
                                }
                            }
                        }
                        statusDiv.innerHTML = '<div class="status status-success">✅ HESAPLAMA kaydı yüklendi! (' + (hesaplamaKolons.length/5) + ' koşu)</div>';
                    }
                }
                if (currentKarsilastirmaData) {
                    buildTable();
                }
            } catch (error) {
                statusDiv.innerHTML = '<div class="status status-error">❌ Yükleme hatası: ' + error.message + '</div>';
            }
        }
        
        function addColumn() {
            const colName = prompt('Yeni sütun adı:', 'HESAP-' + (ekSutunlar.length + 1));
            if (colName) {
                ekSutunlar.push(colName);
                sutunFormulleri[colName] = '';
                buildTable();
            }
        }
        
        function deleteColumn(index) {
            const colName = ekSutunlar[index];
            if (confirm('"' + colName + '" sütununu silmek istediğinize emin misiniz?')) {
                ekSutunlar.splice(index, 1);
                delete sutunFormulleri[colName];
                buildTable();
            }
        }
        
        function insertFormula(colName, formula) {
            sutunFormulleri[colName] = formula;
            const input = document.querySelector(`.col-formula-input[data-colname="${colName}"]`);
            if (input) input.value = formula;
            applyAllFormatting();
        }
        
        function buildTable() {
            if (!currentKarsilastirmaData) return;
            const allColumns = [...sutunlar, ...hesaplamaKolons, ...ekSutunlar];
            let html = '';
            html += `<div style="margin-bottom:15px;">
                        <button class="add-col-btn" onclick="addColumn()">➕ Yeni Sütun Ekle</button>
                        <div class="formula-help">
                            <span class="formula-tag" onclick="if(currentColName) insertFormula(currentColName, '=MIN(' + currentColName + ')')">MIN (en küçük yeşil)</span>
                            <span class="formula-tag" onclick="if(currentColName) insertFormula(currentColName, '=MAX(' + currentColName + ')')">MAX (en büyük kırmızı)</span>
                            <span class="formula-tag" onclick="if(currentColName) insertFormula(currentColName, '=MIN_MAX(' + currentColName + ')')">MIN+MAX (yeşil+kırmızı)</span>
                            <span class="formula-tag" onclick="if(currentColName) { let esik = prompt('Eşik değeri girin (örn: 0.55)'); if(esik) insertFormula(currentColName, '=ESIK(' + esik + '; RENK(255;255;0))'); }">EŞİK (sarı)</span>
                        </div>
                        <div class="formula-help" style="margin-top:5px;">
                            💡 İpucu: Önce bir sütuna tıklayın, sonra yukarıdaki formüllerden birini seçin
                        </div>
                    </div>`;
            
            for (let i = 0; i < currentKarsilastirmaData.length; i++) {
                const race = currentKarsilastirmaData[i];
                html += `<div class="race-card">`;
                html += `<div class="race-header">🏆 ${race.raceNo}. KOŞU (${race.horseCount} at)</div>`;
                html += '<div style="overflow-x:auto;">';
                html += '<table border="0" cellpadding="5" cellspacing="0">';
                html += '<thead><tr>';
                for (let c = 0; c < allColumns.length; c++) {
                    let colHeader = allColumns[c];
                    let formulaInput = '';
                    if (ekSutunlar.includes(colHeader)) {
                        const idx = ekSutunlar.indexOf(colHeader);
                        const currentFormula = sutunFormulleri[colHeader] || '';
                        formulaInput = `<div><input type="text" class="col-formula-input" data-colname="${colHeader}" placeholder="=MIN(${colHeader})" value="${currentFormula}" style="width:100%;" onclick="window.currentColName='${colHeader}'"></div>`;
                        colHeader = `${colHeader} <button class="delete-col-btn" onclick="deleteColumn(${idx})">✖</button>`;
                    }
                    html += `<th>${colHeader}${formulaInput}</th>`;
                }
                html += '</thead><tbody>';
                
                for (let j = 0; j < race.horses.length; j++) {
                    const horse = race.horses[j];
                    html += '<tr>';
                    html += `<td><input type="text" value="${horse.sira}" data-race="${i}" data-horse="${j}" data-col="sira" style="width:50px;"></td>`;
                    html += `<td><input type="text" value="${escapeHtml(horse.atIsmi)}" data-race="${i}" data-horse="${j}" data-col="atIsmi" style="min-width:120px;"></td>`;
                    html += `<td><input type="text" value="${horse.atId}" data-race="${i}" data-horse="${j}" data-col="atId" style="width:90px;"></td>`;
                    
                    for (let h = 0; h < hesaplamaKolons.length; h++) {
                        const kolonAdi = hesaplamaKolons[h];
                        let deger = '';
                        if (kolonAdi.includes('TARİH')) {
                            const kosuIndex = parseInt(kolonAdi.split('-')[0].substring(1)) - 1;
                            deger = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'tarih');
                        } else if (kolonAdi.includes('MESAFE')) {
                            const kosuIndex = parseInt(kolonAdi.split('-')[0].substring(1)) - 1;
                            deger = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'mesafe');
                        } else if (kolonAdi.includes('DERECE')) {
                            const kosuIndex = parseInt(kolonAdi.split('-')[0].substring(1)) - 1;
                            deger = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'at_derece');
                        } else if (kolonAdi.includes('SON800-1')) {
                            const kosuIndex = parseInt(kolonAdi.split('-')[0].substring(1)) - 1;
                            deger = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'son800_bir');
                        } else if (kolonAdi.includes('SON800-2')) {
                            const kosuIndex = parseInt(kolonAdi.split('-')[0].substring(1)) - 1;
                            deger = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'son800_iki');
                        }
                        html += `<td><input type="text" value="${deger}" data-race="${i}" data-horse="${j}" data-col="hesap_${h}" style="width:80px;" readonly></td>`;
                    }
                    
                    for (let e = 0; e < ekSutunlar.length; e++) {
                        html += `<td><input type="text" class="formula-input" placeholder="Değer girin" data-race="${i}" data-horse="${j}" data-col="ek_${e}" style="width:100px;"></td>`;
                    }
                    html += '</tr>';
                }
                html += '</tbody></table></div></div><br>';
            }
            document.getElementById('yonetimResults').innerHTML = html;
            
            document.querySelectorAll('.col-formula-input').forEach(input => {
                const colName = input.dataset.colname;
                input.onchange = () => {
                    sutunFormulleri[colName] = input.value;
                    applyAllFormatting();
                };
            });
            
            document.querySelectorAll('input[data-col]').forEach(input => {
                input.onchange = () => {
                    if (input.dataset.col.startsWith('ek_')) {
                        applyAllFormatting();
                    }
                };
            });
        }
        
        document.getElementById('calismalariGetirBtn').onclick = async () => {
            const statusDiv = document.getElementById('yonetimStatus');
            const calismaListesiDiv = document.getElementById('calismaListesi');
            statusDiv.innerHTML = '<div class="status status-loading">⏳ Kayıtlı çalışmalar yükleniyor...</div>';
            try {
                const response = await fetch('/api/yonetim-calismalari-v2');
                const result = await response.json();
                if (!result.success) throw new Error(result.error);
                if (result.calismalar.length === 0) {
                    calismaListesiDiv.innerHTML = '<div class="empty">⚠️ Hiç kayıtlı çalışma bulunamadı.</div>';
                    calismaListesiDiv.style.display = 'block';
                    statusDiv.innerHTML = '<div class="status status-error">⚠️ Hiç çalışma yok</div>';
                    return;
                }
                let html = '<div style="margin-bottom:10px; font-weight:bold;">📂 KAYITLI ÇALIŞMALARIM:</div>';
                for (let i = 0; i < result.calismalar.length; i++) {
                    const c = result.calismalar[i];
                    html += `<div class="kayit-item" data-id="${c.id}" data-ad="${c.ad}">
                        <span>📝 ${c.ad} | 📅 ${c.kayit_tarihi}</span>
                        <span style="color:#4CAF50;">📂 Yükle →</span>
                    </div>`;
                }
                calismaListesiDiv.innerHTML = html;
                calismaListesiDiv.style.display = 'block';
                document.getElementById('kayitListesi').style.display = 'none';
                document.querySelectorAll('#calismaListesi .kayit-item').forEach(item => {
                    item.onclick = async () => {
                        const id = item.dataset.id;
                        await loadCalisma(id);
                    };
                });
                statusDiv.innerHTML = '<div class="status status-success">✅ ' + result.calismalar.length + ' çalışma bulundu.</div>';
            } catch (error) {
                statusDiv.innerHTML = '<div class="status status-error">❌ Hata: ' + error.message + '</div>';
            }
        };
        
        async function loadCalisma(id) {
            const statusDiv = document.getElementById('yonetimStatus');
            statusDiv.innerHTML = '<div class="status status-loading">⏳ Çalışma yükleniyor...</div>';
            try {
                const response = await fetch('/api/yonetim-calisma-v2/' + id);
                const result = await response.json();
                if (!result.success) throw new Error(result.error);
                currentKarsilastirmaId = result.calisma.karsilastirma_kayit_id;
                currentHesaplamaId = result.calisma.hesaplama_kayit_id;
                ekSutunlar = JSON.parse(result.calisma.sutun_yapisi || '[]');
                sutunFormulleri = JSON.parse(result.calisma.hesaplamalar || '{}');
                if (currentKarsilastirmaId) {
                    const karsResponse = await fetch('/api/karsilastirma-kayit/' + currentKarsilastirmaId);
                    const karsResult = await karsResponse.json();
                    if (karsResult.success) currentKarsilastirmaData = karsResult.kayit.siralama_veri;
                }
                if (currentHesaplamaId) {
                    const hesaplamaResponse = await fetch('/api/hesaplama-kayit/' + currentHesaplamaId);
                    const hesaplamaResult = await hesaplamaResponse.json();
                    if (hesaplamaResult.success) {
                        currentHesaplamaData = hesaplamaResult.kayit.veri;
                        if (currentHesaplamaData && currentHesaplamaData.length > 0 && currentHesaplamaData[0].horses && currentHesaplamaData[0].horses.length > 0) {
                            const ilkAt = currentHesaplamaData[0].horses[0];
                            if (ilkAt.kosular) {
                                const kosuSayisi = ilkAt.kosular.length;
                                hesaplamaKolons = [];
                                for (let i = 1; i <= kosuSayisi; i++) {
                                    hesaplamaKolons.push(`K${i}-TARİH`, `K${i}-MESAFE`, `K${i}-DERECE`, `K${i}-SON800-1`, `K${i}-SON800-2`);
                                }
                            }
                        }
                    }
                }
                buildTable();
                statusDiv.innerHTML = '<div class="status status-success">✅ Çalışma yüklendi!</div>';
            } catch (error) {
                statusDiv.innerHTML = '<div class="status status-error">❌ Yükleme hatası: ' + error.message + '</div>';
            }
        }
        
        document.getElementById('calismayiKaydetBtn').onclick = () => {
            if (!currentKarsilastirmaData) {
                document.getElementById('yonetimStatus').innerHTML = '<div class="status status-error">❌ Önce bir KARŞILAŞTIRMA kaydı seçin veya EXCEL YÜKLE ile dosya yükleyin!</div>';
                return;
            }
            document.getElementById('saveModal').style.display = 'block';
            document.getElementById('saveModalContent').style.display = 'block';
        };
        
        document.getElementById('saveModalClose').onclick = () => {
            document.getElementById('saveModal').style.display = 'none';
            document.getElementById('saveModalContent').style.display = 'none';
        };
        
        document.getElementById('saveModalConfirm').onclick = async () => {
            const ad = document.getElementById('calismaAdi').value;
            const aciklama = document.getElementById('calismaAciklama').value;
            if (!ad) {
                document.getElementById('yonetimStatus').innerHTML = '<div class="status status-error">❌ Lütfen bir çalışma adı girin!</div>';
                return;
            }
            document.getElementById('saveModal').style.display = 'none';
            document.getElementById('saveModalContent').style.display = 'none';
            document.getElementById('yonetimStatus').innerHTML = '<div class="status status-loading">⏳ Çalışma kaydediliyor...</div>';
            const veri = {
                ad: ad,
                aciklama: aciklama,
                karsilastirma_kayit_id: currentKarsilastirmaId,
                hesaplama_kayit_id: currentHesaplamaId,
                tablo_veri: currentKarsilastirmaData,
                sutun_yapisi: JSON.stringify(ekSutunlar),
                hesaplamalar: JSON.stringify(sutunFormulleri)
            };
            try {
                const response = await fetch('/api/yonetim-calisma-kaydet-v2', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(veri)
                });
                const result = await response.json();
                if (result.success) {
                    document.getElementById('yonetimStatus').innerHTML = '<div class="status status-success">✅ Çalışma kaydedildi! (ID: ' + result.id + ')</div>';
                    document.getElementById('calismaAdi').value = '';
                    document.getElementById('calismaAciklama').value = '';
                } else {
                    throw new Error(result.error);
                }
            } catch (error) {
                document.getElementById('yonetimStatus').innerHTML = '<div class="status status-error">❌ Kayıt hatası: ' + error.message + '</div>';
            }
        };
        
        function escapeHtml(s) {
            if (!s) return '-';
            return s.replace(/[&<>]/g, function(m) {
                return m === '&' ? '&amp;' : m === '<' ? '&lt;' : '&gt;';
            });
        }
        
        window.addColumn = addColumn;
        window.deleteColumn = deleteColumn;
        window.insertFormula = insertFormula;
    </script>
</body>
</html>
