<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Yönetim - 88ATSPEED</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: transparent; color: #fff; }
        .yonetim-controls { background: rgba(30,30,60,0.8); border-radius: 20px; padding: 20px; margin-bottom: 20px; display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap; }
        .control-group { display: flex; flex-direction: column; gap: 8px; }
        .control-label { font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; color: #ff9800; }
        .yonetim-btn { padding: 12px 20px; font-size: 14px; font-weight: 600; border-radius: 12px; cursor: pointer; background: linear-gradient(135deg, #ff9800, #f44336); color: white; min-width: 160px; border: none; }
        .yonetim-btn:hover { opacity: 0.9; transform: translateY(-2px); }
        .save-btn { background: linear-gradient(135deg, #2196F3, #1976D2); }
        .excel-btn { background: linear-gradient(135deg, #4CAF50, #2E7D32); }
        .upload-btn { background: linear-gradient(135deg, #9C27B0, #6A1B9A); }
        .results-table { background: rgba(30,30,60,0.6); border-radius: 20px; overflow-x: auto; padding: 15px; }
        table { width: 100%; border-collapse: collapse; font-size: 11px; }
        th, td { padding: 6px 8px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.1); border-right: 1px solid rgba(255,255,255,0.05); vertical-align: top; }
        th { background: rgba(0,0,0,0.4); color: #ff9800; font-weight: 600; position: sticky; top: 0; }
        td input, td select { background: #1a1a3e; border: 1px solid #ff9800; color: white; padding: 4px 6px; border-radius: 6px; width: 100%; font-size: 11px; }
        .formula-input { background: #1a1a3e; border: 1px solid #4CAF50; color: #4CAF50; font-family: monospace; }
        .col-formula-input { background: #0a2a4a; border: 1px solid #ff9800; color: #ff9800; font-family: monospace; font-size: 10px; width: 100%; text-align: center; }
        .status { padding: 12px; border-radius: 12px; margin-bottom: 15px; text-align: center; }
        .status-loading { background: rgba(255,152,0,0.2); color: #ff9800; }
        .status-success { background: rgba(76,175,80,0.2); color: #4CAF50; }
        .status-error { background: rgba(244,67,54,0.2); color: #f44336; }
        .status-warning { background: rgba(255,152,0,0.2); color: #ff9800; }
        .empty { text-align: center; padding: 60px; color: rgba(255,255,255,0.5); }
        .kayit-listesi { background: rgba(0,0,0,0.3); border-radius: 12px; padding: 10px; margin-bottom: 15px; max-height: 200px; overflow-y: auto; }
        .kayit-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; margin: 3px 0; background: rgba(255,255,255,0.05); border-radius: 8px; cursor: pointer; font-size: 12px; }
        .kayit-item:hover { background: rgba(255,152,0,0.2); }
        .kayit-item.selected { background: rgba(255,152,0,0.4); }
        .race-card { background: rgba(30,30,60,0.4); border-radius: 16px; margin-bottom: 20px; overflow: hidden; }
        .race-header { background: linear-gradient(135deg, rgba(255,152,0,0.2), rgba(76,175,80,0.1)); padding: 10px 15px; font-weight: bold; font-size: 14px; }
        .add-col-btn { background: #4CAF50; color: white; border: none; padding: 5px 10px; border-radius: 6px; cursor: pointer; font-size: 11px; margin-left: 10px; }
        .delete-col-btn { background: #f44336; color: white; border: none; padding: 2px 6px; border-radius: 4px; cursor: pointer; font-size: 10px; margin-left: 5px; }
        .modal { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #1a1a3e; padding: 20px; border-radius: 12px; z-index: 1000; display: none; min-width: 400px; }
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 999; display: none; }
        .formula-help { font-size: 10px; color: #aaa; margin-top: 5px; display: flex; gap: 10px; flex-wrap: wrap; }
        .formula-tag { background: #0a2a4a; padding: 2px 6px; border-radius: 4px; cursor: pointer; }
        .formula-tag:hover { background: #ff9800; color: #000; }
        .excel-buttons { display: flex; gap: 10px; }
        .file-input { display: none; }
        .formula-panel { background: rgba(0,0,0,0.3); border-radius: 12px; padding: 10px; margin-bottom: 15px; }
        .btn-special { background: #ff9800; color: #000; }
        .btn-special:hover { background: #ff5722; color: #fff; }
        .dynamic-buttons { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 5px; }
        .kosu-buton { background: #2196F3; color: white; padding: 3px 8px; border-radius: 12px; font-size: 10px; cursor: pointer; }
        .kosu-buton:hover { background: #0b7dda; }
        .son800-buton { background: #4CAF50; color: white; padding: 3px 8px; border-radius: 12px; font-size: 10px; cursor: pointer; }
        .son800-buton:hover { background: #2E7D32; }
    </style>
</head>
<body>
<div id="yonetimContainer">
<div class="yonetim-controls">
<div class="control-group"><div class="control-label">📋 KARŞILAŞTIRMA KAYDI</div><button id="karsilastirmaKayitlariBtn" class="yonetim-btn">KARŞILAŞTIRMA KAYITLARI</button></div>
<div class="control-group"><div class="control-label">📊 HESAPLAMA KAYDI</div><button id="hesaplamaKayitlariBtn" class="yonetim-btn">HESAPLAMA KAYITLARI</button></div>
<div class="control-group"><div class="control-label">💾 ÇALIŞMAYI KAYDET</div><button id="calismayiKaydetBtn" class="yonetim-btn save-btn">KAYDET</button></div>
<div class="control-group"><div class="control-label">📂 ÇALIŞMALARIM</div><button id="calismalariGetirBtn" class="yonetim-btn">KAYITLI ÇALIŞMALAR</button></div>
<div class="excel-buttons">
<div class="control-group"><div class="control-label">📊 EXCEL AKTAR</div><button id="csvIndirBtn" class="yonetim-btn excel-btn">CSV İNDİR</button></div>
<div class="control-group"><div class="control-label">📗 EXCEL AKTAR</div><button id="excelIndirBtn" class="yonetim-btn excel-btn">EXCEL İNDİR</button></div>
<div class="control-group"><div class="control-label">📂 EXCEL YÜKLE</div><button id="excelYukleBtn" class="yonetim-btn upload-btn">EXCEL YÜKLE</button><input type="file" id="excelFileInput" class="file-input" accept=".csv,.xlsx,.xls"></div>
</div>
</div>
<div id="kayitListesi" class="kayit-listesi" style="display:none;"></div>
<div id="calismaListesi" class="kayit-listesi" style="display:none;"></div>
<div id="yonetimStatus"></div>
<div id="yonetimResults" class="results-table"><div class="empty">🏇 Önce KARŞILAŞTIRMA ve HESAPLAMA kayıtlarını seçin veya EXCEL YÜKLE ile dosya yükleyin</div></div>
</div>
<div id="saveModal" class="modal-overlay"></div>
<div id="saveModalContent" class="modal"><h3 style="margin-bottom:15px;">💾 Çalışmayı Kaydet</h3>
<div class="control-group" style="margin-bottom:15px;"><div class="control-label">ÇALIŞMA ADI</div><input type="text" id="calismaAdi" style="padding:8px; border-radius:8px; background:#0f3460; color:white; border:none; width:100%;"></div>
<div class="control-group" style="margin-bottom:15px;"><div class="control-label">AÇIKLAMA</div><textarea id="calismaAciklama" rows="3" style="padding:8px; border-radius:8px; background:#0f3460; color:white; border:none; width:100%;"></textarea></div>
<div style="display:flex; gap:10px; justify-content:flex-end;"><button id="saveModalClose" style="padding:8px 20px; border-radius:8px; background:#555; color:white; border:none;">İPTAL</button><button id="saveModalConfirm" style="padding:8px 20px; border-radius:8px; background:#4CAF50; color:white; border:none;">KAYDET</button></div>
</div>
<script>
// Global değişkenler - window nesnesine tanımla
window.currentKarsilastirmaData = null;
window.currentHesaplamaData = null;
window.currentKarsilastirmaId = null;
window.currentHesaplamaId = null;
window.sutunlar = ['SIRA', 'AT İSMİ', 'AT ID'];
window.hesaplamaKolons = [];
window.ekSutunlar = [];
window.sutunFormulleri = {};
window.formulVerileri = null;
window.mevcutKosuSayisi = 0;
window.currentColName = null;

// Kısayol değişkenler (window üzerinden)
var currentKarsilastirmaData = window.currentKarsilastirmaData;
var currentHesaplamaData = window.currentHesaplamaData;
var currentKarsilastirmaId = window.currentKarsilastirmaId;
var currentHesaplamaId = window.currentHesaplamaId;
var sutunlar = window.sutunlar;
var hesaplamaKolons = window.hesaplamaKolons;
var ekSutunlar = window.ekSutunlar;
var sutunFormulleri = window.sutunFormulleri;
var formulVerileri = window.formulVerileri;
var mevcutKosuSayisi = window.mevcutKosuSayisi;
var currentColName = window.currentColName;

async function formulleriYukle() {
    try {
        const response = await fetch('/formuller.json');
        window.formulVerileri = await response.json();
        formulVerileri = window.formulVerileri;
        console.log('✅ Formuller yuklendi');
        return true;
    } catch (error) {
        console.error('❌ Formuller yuklenemedi:', error);
        return false;
    }
}

function dereceToSalise(d){if(!d||d==='-')return null;let s=d.toString().trim();s=s.replace(/:/g,'.');let p=s.split('.');if(p.length===3){let dk=parseInt(p[0])||0,sn=parseInt(p[1])||0,sl=parseInt(p[2])||0;return(dk*60*100)+(sn*100)+sl;}else if(p.length===2){let sn=parseInt(p[0])||0,sl=parseInt(p[1])||0;return(sn*100)+sl;}else if(p.length===1){return parseInt(p[0])||0;}return null;}
function saliseToDerece(s){if(s===null||s===undefined)return '-';let ts=Math.floor(Math.abs(s));let dk=Math.floor(ts/6000);let ks=ts%6000;let sn=Math.floor(ks/100);let kl=ks%100;return dk+'.'+sn.toString().padStart(2,'0')+'.'+kl.toString().padStart(2,'0');}
function dereceToSayi(d){if(!d||d==='-')return null;return dereceToSalise(d);}

function metreBasinaSaliseHesapla(mesafe, derece) {
    if (!mesafe || !derece || derece === '-') return null;
    const mesafeSayi = parseInt(mesafe);
    if (isNaN(mesafeSayi) || mesafeSayi === 0) return null;
    const toplamSalise = dereceToSalise(derece);
    if (toplamSalise === null) return null;
    return (toplamSalise / mesafeSayi).toFixed(4);
}

// SON800 değerini saliseye çevir (tek değer için)
function son800ToSalise(derece) {
    if (!derece || derece === '-') return null;
    return dereceToSalise(derece);
}

function getAtHesaplamaVerisi(atId,kosuIndex,field){
    if(!window.currentHesaplamaData)return '';
    for(let race of window.currentHesaplamaData){
        for(let horse of race.horses){
            if(horse.atId==atId&&horse.kosular&&horse.kosular[kosuIndex]){
                return horse.kosular[kosuIndex][field]||'-';
            }
        }
    }
    return '-';
}

function getColumnValues(colName,raceIndex){
    let v=[];
    if(!window.currentKarsilastirmaData)return v;
    let race=window.currentKarsilastirmaData[raceIndex];
    if(!race)return v;
    let ci=window.ekSutunlar.indexOf(colName);
    if(ci===-1)return v;
    for(let j=0;j<race.horses.length;j++){
        let inp=document.querySelector('input[data-race="'+raceIndex+'"][data-horse="'+j+'"][data-col="ek_'+ci+'"]');
        if(inp&&inp.value){
            let val=dereceToSayi(inp.value);
            if(val===null)val=parseFloat(inp.value);
            if(val!==null&&!isNaN(val))v.push({val:val,input:inp,j:j,rawValue:inp.value});
        }
    }
    return v;
}

// ============ GELİŞMİŞ FORMÜL MOTORU (MIN3 + FARK DESTEKLİ) ============
function applyAdvancedFormula(colName, raceIndex, formula, values) {
    let expr = formula.substring(1).toUpperCase();
    
    // METRE_BASI_SALISE(K1-MESAFE;K1-DERECE) formatını yakala
    let metreMatch = expr.match(/METRE_BASI_SALISE\(([^;]+);([^)]+)\)/);
    if(metreMatch) {
        const mesafeSutun = metreMatch[1].trim();
        const kosuNo = parseInt(mesafeSutun.match(/K(\d+)/)?.[1] || 0);
        if(kosuNo > 0) {
            const kosuIndex = kosuNo - 1;
            const colIndex = window.ekSutunlar.indexOf(colName);
            
            if(values.length === 0 && colIndex !== -1) {
                for(let i=0; i<window.currentKarsilastirmaData.length; i++) {
                    const race = window.currentKarsilastirmaData[i];
                    for(let j=0; j<race.horses.length; j++) {
                        const horse = race.horses[j];
                        const mesafe = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'mesafe');
                        const derece = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'at_derece');
                        if(mesafe && derece && derece !== '-') {
                            const mesafeSayi = parseInt(mesafe);
                            const toplamSalise = dereceToSalise(derece);
                            if(mesafeSayi > 0 && toplamSalise !== null) {
                                const sonuc = (toplamSalise / mesafeSayi).toFixed(4);
                                const inp = document.querySelector(`input[data-race="${i}"][data-horse="${j}"][data-col="ek_${colIndex}"]`);
                                if(inp) {
                                    inp.value = sonuc;
                                    inp.style.backgroundColor = '#FF9800';
                                    inp.style.color = '#000';
                                }
                            }
                        }
                    }
                }
                // ★★★ RENKLENDİRME: Her koşu bloğu için ayrı ayrı en küçük 3 değeri bul ★★★
                setTimeout(() => {
                    for(let k=0; k<window.currentKarsilastirmaData.length; k++) {
                        const raceValues = [];
                        for(let m=0; m<window.currentKarsilastirmaData[k].horses.length; m++) {
                            const inp = document.querySelector(`input[data-race="${k}"][data-horse="${m}"][data-col="ek_${colIndex}"]`);
                            if(inp && inp.value && !isNaN(parseFloat(inp.value))) {
                                raceValues.push({ val: parseFloat(inp.value), input: inp });
                            }
                        }
                        if(raceValues.length > 0) {
                            const sorted = [...raceValues].sort((a,b) => a.val - b.val);
                            const min3Values = sorted.slice(0, 3).map(v => v.val);
                            for(let v of raceValues) {
                                if(min3Values.includes(v.val)) {
                                    const idx = min3Values.indexOf(v.val);
                                    if(idx === 0) {
                                        v.input.style.backgroundColor = '#00ff00';
                                        v.input.style.color = '#000';
                                    } else if(idx === 1) {
                                        v.input.style.backgroundColor = '#66ff66';
                                        v.input.style.color = '#000';
                                    } else {
                                        v.input.style.backgroundColor = '#aaffaa';
                                        v.input.style.color = '#000';
                                    }
                                } else {
                                    v.input.style.backgroundColor = '#FF9800';
                                    v.input.style.color = '#000';
                                }
                            }
                        }
                    }
                }, 100);
                return;
            }
            
            for(let v of values) {
                const horse = window.currentKarsilastirmaData[raceIndex].horses[v.j];
                const mesafe = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'mesafe');
                const derece = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'at_derece');
                if(mesafe && derece && derece !== '-') {
                    const mesafeSayi = parseInt(mesafe);
                    const toplamSalise = dereceToSalise(derece);
                    if(mesafeSayi > 0 && toplamSalise !== null) {
                        v.input.value = (toplamSalise / mesafeSayi).toFixed(4);
                        v.input.style.backgroundColor = '#FF9800';
                        v.input.style.color = '#000';
                    }
                }
            }
            return;
        }
    }
    
    // ★★★ YENİ: FARK(K7-METRE;K6-METRE) formülü ★★★
    let farkMatch = expr.match(/FARK\(([^;]+);([^)]+)\)/);
    if(farkMatch) {
        const sutun1 = farkMatch[1].trim();
        const sutun2 = farkMatch[2].trim();
        // sutun1 ve sutun2 formatı: "K7-METRE" veya "K6-METRE" gibi
        // Bu değerleri bulmak için mevcut hesaplanmış sütunları okumamız gerek
        // Şimdilik bu formülü not edelim, ileride geliştirilecek
        console.log('FARK formülü tespit edildi:', sutun1, '-', sutun2);
        // TODO: İki sütun arasındaki farkı hesapla
        for(let v of values) {
            v.input.value = '0';
            v.input.style.backgroundColor = '#ff9800';
        }
        return;
    }
    
    // SON800_METRE_SALISE(K1-SON800-1;K1-SON800-2) formatını yakala
    let son800Match = expr.match(/SON800_METRE_SALISE\(([^;]+);([^)]+)\)/);
    if(son800Match) {
        const son800Sutun1 = son800Match[1].trim();
        const son800Sutun2 = son800Match[2].trim();
        const kosuNo = parseInt(son800Sutun1.match(/K(\d+)/)?.[1] || 0);
        if(kosuNo > 0) {
            const kosuIndex = kosuNo - 1;
            const colIndex = window.ekSutunlar.indexOf(colName);
            
            if(values.length === 0 && colIndex !== -1) {
                for(let i=0; i<window.currentKarsilastirmaData.length; i++) {
                    const race = window.currentKarsilastirmaData[i];
                    for(let j=0; j<race.horses.length; j++) {
                        const horse = race.horses[j];
                        const son8001 = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'son800_bir');
                        const son8002 = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'son800_iki');
                        let ortalamaSalise = 0;
                        let sayac = 0;
                        let s1 = dereceToSalise(son8001);
                        let s2 = dereceToSalise(son8002);
                        if(s1 !== null) { ortalamaSalise += s1; sayac++; }
                        if(s2 !== null) { ortalamaSalise += s2; sayac++; }
                        if(sayac > 0) {
                            ortalamaSalise = ortalamaSalise / sayac;
                            const sonuc = (ortalamaSalise / 800).toFixed(4);
                            const inp = document.querySelector(`input[data-race="${i}"][data-horse="${j}"][data-col="ek_${colIndex}"]`);
                            if(inp) {
                                inp.value = sonuc;
                                inp.style.backgroundColor = '#4CAF50';
                                inp.style.color = '#000';
                            }
                        }
                    }
                }
                return;
            }
            
            for(let v of values) {
                const horse = window.currentKarsilastirmaData[raceIndex].horses[v.j];
                const son8001 = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'son800_bir');
                const son8002 = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'son800_iki');
                let ortalamaSalise = 0;
                let sayac = 0;
                let s1 = dereceToSalise(son8001);
                let s2 = dereceToSalise(son8002);
                if(s1 !== null) { ortalamaSalise += s1; sayac++; }
                if(s2 !== null) { ortalamaSalise += s2; sayac++; }
                if(sayac > 0) {
                    ortalamaSalise = ortalamaSalise / sayac;
                    v.input.value = (ortalamaSalise / 800).toFixed(4);
                    v.input.style.backgroundColor = '#4CAF50';
                    v.input.style.color = '#000';
                }
            }
            return;
        }
    }
    
    // TOPLA formülü
    if(expr === 'TOPLA(' + colName.toUpperCase() + ')') {
        let total = values.reduce((s,v) => s + v.val, 0);
        for(let v of values) {
            v.input.value = total;
            v.input.style.backgroundColor = '#ff9800';
        }
        return;
    }
    
    // ORTALAMA formülü
    if(expr === 'ORTALAMA(' + colName.toUpperCase() + ')') {
        let avg = values.reduce((s,v) => s + v.val, 0) / values.length;
        for(let v of values) {
            v.input.value = avg.toFixed(4);
            v.input.style.backgroundColor = '#ff9800';
        }
        return;
    }
    
    // FARK formülü (basit)
    if(expr === 'FARK(' + colName.toUpperCase() + ')') {
        let maxV = Math.max(...values.map(v => v.val));
        let minV = Math.min(...values.map(v => v.val));
        let fark = maxV - minV;
        for(let v of values) {
            v.input.value = fark.toFixed(4);
            v.input.style.backgroundColor = '#ff9800';
        }
        return;
    }
    
    // SALISE_CEVIR formülü
    if(expr === 'SALISE_CEVIR(' + colName.toUpperCase() + ')') {
        for(let v of values) {
            let sal = dereceToSalise(v.input.value);
            v.input.value = sal !== null ? sal.toString() : '-';
            v.input.style.backgroundColor = '#4CAF50';
        }
        return;
    }
    
    // DERECE_CEVIR formülü
    if(expr === 'DERECE_CEVIR(' + colName.toUpperCase() + ')') {
        for(let v of values) {
            let say = parseFloat(v.input.value);
            v.input.value = saliseToDerece(say);
            v.input.style.backgroundColor = '#2196F3';
        }
        return;
    }
    
    // TOPLA_SALISE formülü
    if(expr === 'TOPLA_SALISE(' + colName.toUpperCase() + ')') {
        let total = values.reduce((s,v) => s + v.val, 0);
        let totalDerece = saliseToDerece(total);
        for(let v of values) {
            v.input.value = totalDerece;
            v.input.style.backgroundColor = '#ff9800';
        }
        return;
    }
    
    // ORTALAMA_SALISE formülü
    if(expr === 'ORTALAMA_SALISE(' + colName.toUpperCase() + ')') {
        let avg = values.reduce((s,v) => s + v.val, 0) / values.length;
        let avgDerece = saliseToDerece(avg);
        for(let v of values) {
            v.input.value = avgDerece;
            v.input.style.backgroundColor = '#ff9800';
        }
        return;
    }
    
    // MIN formülü (renklendirmeli)
    if(expr === 'MIN(' + colName.toUpperCase() + ')') {
        let minVal = Math.min(...values.map(v => v.val));
        for(let v of values) {
            if(v.val === minVal) {
                v.input.style.backgroundColor = '#00ff00';
                v.input.style.color = '#000';
            } else {
                v.input.style.backgroundColor = '#1a1a3e';
                v.input.style.color = 'white';
            }
        }
        return;
    }
    
    // MAX formülü (renklendirmeli)
    if(expr === 'MAX(' + colName.toUpperCase() + ')') {
        let maxVal = Math.max(...values.map(v => v.val));
        for(let v of values) {
            if(v.val === maxVal) {
                v.input.style.backgroundColor = '#ff0000';
                v.input.style.color = '#fff';
            } else {
                v.input.style.backgroundColor = '#1a1a3e';
                v.input.style.color = 'white';
            }
        }
        return;
    }
    
    // MIN_MAX formülü
    if(expr === 'MIN_MAX(' + colName.toUpperCase() + ')') {
        let minVal = Math.min(...values.map(v => v.val));
        let maxVal = Math.max(...values.map(v => v.val));
        for(let v of values) {
            if(v.val === minVal) {
                v.input.style.backgroundColor = '#00ff00';
                v.input.style.color = '#000';
            } else if(v.val === maxVal) {
                v.input.style.backgroundColor = '#ff0000';
                v.input.style.color = '#fff';
            } else {
                v.input.style.backgroundColor = '#1a1a3e';
                v.input.style.color = 'white';
            }
        }
        return;
    }
    
    // MIN3 formülü (en küçük 3 değer - her koşu bloğu için ayrı)
    if(expr === 'MIN3(' + colName.toUpperCase() + ')') {
        // Değerleri topla
        const allValues = [];
        for(let v of values) {
            allValues.push({ val: v.val, input: v.input });
        }
        if(allValues.length > 0) {
            const sorted = [...allValues].sort((a,b) => a.val - b.val);
            const min3Values = sorted.slice(0, 3).map(v => v.val);
            for(let v of allValues) {
                if(min3Values.includes(v.val)) {
                    const idx = min3Values.indexOf(v.val);
                    if(idx === 0) {
                        v.input.style.backgroundColor = '#00ff00';
                        v.input.style.color = '#000';
                    } else if(idx === 1) {
                        v.input.style.backgroundColor = '#66ff66';
                        v.input.style.color = '#000';
                    } else {
                        v.input.style.backgroundColor = '#aaffaa';
                        v.input.style.color = '#000';
                    }
                } else {
                    v.input.style.backgroundColor = '#1a1a3e';
                    v.input.style.color = 'white';
                }
            }
        }
        return;
    }
    
    // EŞİK formülü
    let esikMatch = expr.match(/ESIK\(([\d\.]+);\s*RENK\((\d+);(\d+);(\d+)\)\)/);
    if(esikMatch) {
        let esik = parseFloat(esikMatch[1]);
        let r = parseInt(esikMatch[2]);
        let g = parseInt(esikMatch[3]);
        let b = parseInt(esikMatch[4]);
        for(let v of values) {
            if(v.val > esik) {
                v.input.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;
                v.input.style.color = '#fff';
            } else {
                v.input.style.backgroundColor = '#1a1a3e';
                v.input.style.color = 'white';
            }
        }
        return;
    }
    
    console.log('⚠️ Tanınmayan formül:', formula);
}

function applyColumnFormatting(colName,raceIndex){
    let formula=window.sutunFormulleri[colName];
    if(!formula||!formula.startsWith('='))return;
    let values=getColumnValues(colName,raceIndex);
    applyAdvancedFormula(colName,raceIndex,formula,values);
}

function applyAllFormatting(){
    if(!window.currentKarsilastirmaData)return;
    for(let i=0;i<window.currentKarsilastirmaData.length;i++){
        for(let s of window.ekSutunlar){
            applyColumnFormatting(s,i);
        }
    }
}

function collectTableData(){
    if(!window.currentKarsilastirmaData)return[];
    let allCols=[...window.sutunlar,...window.hesaplamaKolons,...window.ekSutunlar];
    let data=[allCols];
    for(let i=0;i<window.currentKarsilastirmaData.length;i++){
        let race=window.currentKarsilastirmaData[i];
        for(let j=0;j<race.horses.length;j++){
            let horse=race.horses[j];
            let row=[horse.sira,horse.atIsmi,horse.atId];
            for(let h=0;h<window.hesaplamaKolons.length;h++){
                let kn=window.hesaplamaKolons[h];
                let d='';
                if(kn.includes('TARİH')){
                    let ki=parseInt(kn.split('-')[0].substring(1))-1;
                    d=getAtHesaplamaVerisi(horse.atId,ki,'tarih');
                }else if(kn.includes('MESAFE')){
                    let ki=parseInt(kn.split('-')[0].substring(1))-1;
                    d=getAtHesaplamaVerisi(horse.atId,ki,'mesafe');
                }else if(kn.includes('DERECE')){
                    let ki=parseInt(kn.split('-')[0].substring(1))-1;
                    d=getAtHesaplamaVerisi(horse.atId,ki,'at_derece');
                }else if(kn.includes('SON800-1')){
                    let ki=parseInt(kn.split('-')[0].substring(1))-1;
                    d=getAtHesaplamaVerisi(horse.atId,ki,'son800_bir');
                }else if(kn.includes('SON800-2')){
                    let ki=parseInt(kn.split('-')[0].substring(1))-1;
                    d=getAtHesaplamaVerisi(horse.atId,ki,'son800_iki');
                }
                row.push(d);
            }
            for(let e=0;e<window.ekSutunlar.length;e++){
                let inp=document.querySelector('input[data-race="'+i+'"][data-horse="'+j+'"][data-col="ek_'+e+'"]');
                row.push(inp?inp.value:'');
            }
            data.push(row);
        }
    }
    return data;
}

function downloadCSV(){
    let data=collectTableData();
    if(data.length===0){document.getElementById('yonetimStatus').innerHTML='<div class="status status-error">❌ Önce bir tablo oluşturun!</div>';return;}
    let csvContent=data.map(row=>row.map(cell=>'"'+String(cell).replace(/"/g,'""')+'"').join(',')).join('\n');
    let blob=new Blob(["\uFEFF"+csvContent],{type:'text/csv;charset=utf-8;'});
    let link=document.createElement('a');
    let url=URL.createObjectURL(blob);
    link.href=url;
    link.setAttribute('download','88atspeed_veriler.csv');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    document.getElementById('yonetimStatus').innerHTML='<div class="status status-success">✅ CSV dosyası indirildi!</div>';
}

async function downloadExcel(){
    let data=collectTableData();
    if(data.length===0){document.getElementById('yonetimStatus').innerHTML='<div class="status status-error">❌ Önce bir tablo oluşturun!</div>';return;}
    document.getElementById('yonetimStatus').innerHTML='<div class="status status-loading">⏳ Excel dosyası hazırlanıyor...</div>';
    try{
        let resp=await fetch('/api/excel-export',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({data:data,baslik:'88ATSPEED Verileri'})});
        let res=await resp.json();
        if(res.success){
            let link=document.createElement('a');
            link.href=res.url;
            link.download='88atspeed_veriler.xlsx';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            document.getElementById('yonetimStatus').innerHTML='<div class="status status-success">✅ Excel dosyası indirildi!</div>';
        }else throw new Error(res.error);
    }catch(e){document.getElementById('yonetimStatus').innerHTML='<div class="status status-error">❌ Excel hatası: '+e.message+'</div>';}
}

function uploadExcel(file){
    let r=new FileReader();
    r.onload=function(e){
        let data=e.target.result;
        let wb=XLSX.read(data,{type:'binary'});
        let firstSheet=wb.Sheets[wb.SheetNames[0]];
        let rows=XLSX.utils.sheet_to_json(firstSheet,{header:1,defval:''});
        if(!rows||rows.length<2){document.getElementById('yonetimStatus').innerHTML='<div class="status status-error">❌ Dosyada veri bulunamadı!</div>';return;}
        let headers=rows[0];
        window.currentKarsilastirmaData=[{raceNo:"1",horseCount:rows.length-1,horses:[]}];
        for(let i=1;i<rows.length;i++){let row=rows[i];if(row.length>=3){window.currentKarsilastirmaData[0].horses.push({sira:row[0]||i,atIsmi:row[1]||'Bilinmiyor',atId:row[2]||'-'});}}
        window.ekSutunlar=[];
        for(let c=3;c<headers.length;c++){if(headers[c]&&headers[c].toString().trim()){window.ekSutunlar.push(headers[c].toString());}}
        document.getElementById('yonetimStatus').innerHTML='<div class="status status-success">✅ Excel dosyası yüklendi! '+(rows.length-1)+' at bulundu.</div>';
        buildTable();
    };
    r.readAsBinaryString(file);
}

document.getElementById('karsilastirmaKayitlariBtn').onclick=async()=>{await listKayitlar('/api/karsilastirma-kayitlar','karsilastirma');};
document.getElementById('hesaplamaKayitlariBtn').onclick=async()=>{await listKayitlar('/api/hesaplama-kayitlar','hesaplama');};
document.getElementById('csvIndirBtn').onclick=downloadCSV;
document.getElementById('excelIndirBtn').onclick=downloadExcel;
document.getElementById('excelYukleBtn').onclick=()=>{document.getElementById('excelFileInput').click();};
document.getElementById('excelFileInput').onchange=(e)=>{if(e.target.files&&e.target.files[0]){uploadExcel(e.target.files[0]);}};

async function listKayitlar(apiUrl,tur){
    let sd=document.getElementById('yonetimStatus'),kld=document.getElementById('kayitListesi');
    sd.innerHTML='<div class="status status-loading">⏳ Kayıtlar yükleniyor...</div>';
    try{
        let resp=await fetch(apiUrl);
        let res=await resp.json();
        if(!res.success)throw new Error(res.error);
        let kayitlar=res.kayitlar||res.calismalar||[];
        if(kayitlar.length===0){
            kld.innerHTML='<div class="empty">⚠️ Hiç kayıt bulunamadı</div>';
            kld.style.display='block';
            sd.innerHTML='<div class="status status-error">⚠️ Hiç kayıt yok</div>';
            return;
        }
        let html='<div style="margin-bottom:10px; font-weight:bold;">📋 '+tur.toUpperCase()+' KAYITLARI:</div>';
        for(let i=0;i<kayitlar.length;i++){
            let k=kayitlar[i];
            let kayitAdi=k.ad||(k.tarih+' - '+k.hipodrom);
            html+='<div class="kayit-item" data-id="'+k.id+'" data-tur="'+tur+'" data-adi="'+kayitAdi+'"><span>📅 '+kayitAdi+' | 🕐 '+k.kayit_tarihi+'</span><span style="color:#ff9800;">📂 Seç →</span></div>';
        }
        kld.innerHTML=html;
        kld.style.display='block';
        document.getElementById('calismaListesi').style.display='none';
        document.querySelectorAll('.kayit-item').forEach(item=>{
            item.onclick=async()=>{
                let id=item.dataset.id,tur2=item.dataset.tur;
                document.querySelectorAll('.kayit-item').forEach(i=>i.classList.remove('selected'));
                item.classList.add('selected');
                await loadKayit(id,tur2);
            };
        });
        sd.innerHTML='<div class="status status-success">✅ '+kayitlar.length+' kayıt bulundu.</div>';
    }catch(e){sd.innerHTML='<div class="status status-error">❌ Hata: '+e.message+'</div>';}
}

async function loadKayit(id,tur){
    let sd=document.getElementById('yonetimStatus');
    sd.innerHTML='<div class="status status-loading">⏳ '+tur+' kaydı yükleniyor...</div>';
    try{
        if(tur==='karsilastirma'){
            let resp=await fetch('/api/karsilastirma-kayit/'+id);
            let res=await resp.json();
            if(res.success){
                window.currentKarsilastirmaData=res.kayit.siralama_veri;
                window.currentKarsilastirmaId=id;
                sd.innerHTML='<div class="status status-success">✅ KARŞILAŞTIRMA kaydı yüklendi!</div>';
                if(window.currentHesaplamaData)buildTable();
            }
        }else if(tur==='hesaplama'){
            if(!window.currentKarsilastirmaData){
                sd.innerHTML='<div class="status status-warning">⚠️ Önce bir KARŞILAŞTIRMA kaydı seçin!</div>';
                return;
            }
            let resp=await fetch('/api/hesaplama-kayit/'+id);
            let res=await resp.json();
            if(res.success){
                window.currentHesaplamaData=res.kayit.veri;
                window.currentHesaplamaId=id;
                if(window.currentHesaplamaData&&window.currentHesaplamaData.length>0){
                    for(let race of window.currentHesaplamaData){
                        if(race.horses&&race.horses.length>0){
                            let ilkAt=race.horses[0];
                            if(ilkAt.kosular){
                                let kosuSayisi=ilkAt.kosular.length;
                                window.mevcutKosuSayisi = kosuSayisi;
                                window.hesaplamaKolons=[];
                                for(let i=1;i<=kosuSayisi;i++){
                                    window.hesaplamaKolons.push('K'+i+'-TARİH','K'+i+'-MESAFE','K'+i+'-DERECE','K'+i+'-SON800-1','K'+i+'-SON800-2');
                                }
                                break;
                            }
                        }
                    }
                }
                sd.innerHTML='<div class="status status-success">✅ HESAPLAMA kaydı yüklendi! ('+window.mevcutKosuSayisi+' koşu)</div>';
                buildTable();
            }
        }
    }catch(e){sd.innerHTML='<div class="status status-error">❌ Yükleme hatası: '+e.message+'</div>';}
}

function addColumn(){
    let cn=prompt('Yeni sütun adı:','HESAP-'+(window.ekSutunlar.length+1));
    if(cn){
        window.ekSutunlar.push(cn);
        window.sutunFormulleri[cn]='';
        buildTable();
        applyAllFormatting();
    }
}

function deleteColumn(idx){
    let cn=window.ekSutunlar[idx];
    if(confirm('"'+cn+'" sütununu silmek istediğinize emin misiniz?')){
        window.ekSutunlar.splice(idx,1);
        delete window.sutunFormulleri[cn];
        buildTable();
        applyAllFormatting();
    }
}

function insertFormula(cn,formula){
    console.log('🔧 insertFormula çalıştı!', cn, formula);
    window.sutunFormulleri[cn]=formula;
    let inp=document.querySelector('.col-formula-input[data-colname="'+cn+'"]');
    if(inp)inp.value=formula;
    applyAllFormatting();
    console.log('✅ Formül kaydedildi:', cn, '=', formula);
}

function dinamikKosuButonlariniOlustur() {
    if (!window.formulVerileri || window.mevcutKosuSayisi === 0) return '';
    let html = '<div class="formula-help" style="margin-top:8px;"><strong>📏 METRE BAŞI SALISE (KOŞU BAZLI):</strong><div class="dynamic-buttons">';
    for (let k = 1; k <= window.mevcutKosuSayisi; k++) {
        const formulaMetni = `=METRE_BASI_SALISE(K${k}-MESAFE;K${k}-DERECE)`;
        html += `<span class="formula-tag btn-special kosu-buton" onclick="if(window.currentColName) { hesaplaVeFormuluKaydet(window.currentColName, ${k-1}, '${formulaMetni}'); } else alert('Önce bir sütuna tıklayın!')">📏 K${k} (${k}. Koşu)</span>`;
    }
    html += '</div></div>';
    return html;
}

// SON800 için dinamik butonlar (her değer için ayrı - toplam 14 buton)
function dinamikSon800ButonlariniOlustur() {
    if (!window.formulVerileri || window.mevcutKosuSayisi === 0) return '';
    let html = '<div class="formula-help" style="margin-top:8px;"><strong>📏 SON800 SALİSE ÇEVİR (KOŞU BAZLI):</strong><div class="dynamic-buttons">';
    for (let k = 1; k <= window.mevcutKosuSayisi; k++) {
        // SON800-1 için buton
        const formulaMetni1 = `=SON800_SALISE(K${k}-SON800-1)`;
        html += `<span class="formula-tag son800-buton" onclick="if(window.currentColName) { hesaplaVeSon800TekKaydet(window.currentColName, ${k-1}, 'son800_bir', '${formulaMetni1}'); } else alert('Önce bir sütuna tıklayın!')">📏 K${k}-1 (${k}.Koşu-1)</span>`;
        // SON800-2 için buton
        const formulaMetni2 = `=SON800_SALISE(K${k}-SON800-2)`;
        html += `<span class="formula-tag son800-buton" onclick="if(window.currentColName) { hesaplaVeSon800TekKaydet(window.currentColName, ${k-1}, 'son800_iki', '${formulaMetni2}'); } else alert('Önce bir sütuna tıklayın!')">📏 K${k}-2 (${k}.Koşu-2)</span>`;
    }
    html += '</div></div>';
    return html;
}

function hesaplaVeFormuluKaydet(hedefSutunAdi, kosuIndex, formulaMetni) {
    if (!window.currentKarsilastirmaData) {
        document.getElementById('yonetimStatus').innerHTML = '<div class="status status-warning">⚠️ Önce bir Karşılaştırma kaydı yükleyin!</div>';
        return;
    }
    
    const kosuNo = kosuIndex + 1;
    let hesaplananSayi = 0;
    for (let i = 0; i < window.currentKarsilastirmaData.length; i++) {
        const race = window.currentKarsilastirmaData[i];
        for (let j = 0; j < race.horses.length; j++) {
            const horse = race.horses[j];
            const mesafe = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'mesafe');
            const derece = getAtHesaplamaVerisi(horse.atId, kosuIndex, 'at_derece');
            const sonuc = metreBasinaSaliseHesapla(mesafe, derece);
            if (sonuc !== null) {
                const hedefInput = document.querySelector(`input[data-race="${i}"][data-horse="${j}"][data-col="ek_${window.ekSutunlar.indexOf(hedefSutunAdi)}"]`);
                if (hedefInput) {
                    hedefInput.value = sonuc;
                    hedefInput.style.backgroundColor = '#FF9800';
                    hedefInput.style.color = '#000';
                    hesaplananSayi++;
                }
            }
        }
    }
    
    if (window.currentColName === hedefSutunAdi) {
        window.sutunFormulleri[hedefSutunAdi] = formulaMetni;
        const formulaInput = document.querySelector(`.col-formula-input[data-colname="${hedefSutunAdi}"]`);
        if (formulaInput) formulaInput.value = formulaMetni;
    }
    
    // ★★★ RENKLENDİRME: Her koşu bloğu için ayrı ayrı en küçük 3 değeri bul ★★★
    setTimeout(() => {
        const colIndex = window.ekSutunlar.indexOf(hedefSutunAdi);
        for(let k=0; k<window.currentKarsilastirmaData.length; k++) {
            const raceValues = [];
            for(let m=0; m<window.currentKarsilastirmaData[k].horses.length; m++) {
                const inp = document.querySelector(`input[data-race="${k}"][data-horse="${m}"][data-col="ek_${colIndex}"]`);
                if(inp && inp.value && !isNaN(parseFloat(inp.value))) {
                    raceValues.push({ val: parseFloat(inp.value), input: inp });
                }
            }
            if(raceValues.length > 0) {
                const sorted = [...raceValues].sort((a,b) => a.val - b.val);
                const min3Values = sorted.slice(0, 3).map(v => v.val);
                for(let v of raceValues) {
                    if(min3Values.includes(v.val)) {
                        const idx = min3Values.indexOf(v.val);
                        if(idx === 0) {
                            v.input.style.backgroundColor = '#00ff00';
                            v.input.style.color = '#000';
                        } else if(idx === 1) {
                            v.input.style.backgroundColor = '#66ff66';
                            v.input.style.color = '#000';
                        } else {
                            v.input.style.backgroundColor = '#aaffaa';
                            v.input.style.color = '#000';
                        }
                    } else {
                        v.input.style.backgroundColor = '#FF9800';
                        v.input.style.color = '#000';
                    }
                }
            }
        }
    }, 100);
    
    document.getElementById('yonetimStatus').innerHTML = '<div class="status status-success">✅ ' + hesaplananSayi + ' at için ' + kosuNo + '. koşu metre başı salise hesaplandı! Formül kaydedildi. En küçük 3 değer yeşil renklendi.</div>';
}

// SON800 için tek değer hesaplama ve kaydetme fonksiyonu
function hesaplaVeSon800TekKaydet(hedefSutunAdi, kosuIndex, field, formulaMetni) {
    if (!window.currentKarsilastirmaData) {
        document.getElementById('yonetimStatus').innerHTML = '<div class="status status-warning">⚠️ Önce bir Karşılaştırma kaydı yükleyin!</div>';
        return;
    }
    
    const kosuNo = kosuIndex + 1;
    let hesaplananSayi = 0;
    for (let i = 0; i < window.currentKarsilastirmaData.length; i++) {
        const race = window.currentKarsilastirmaData[i];
        for (let j = 0; j < race.horses.length; j++) {
            const horse = race.horses[j];
            const derece = getAtHesaplamaVerisi(horse.atId, kosuIndex, field);
            const sonuc = son800ToSalise(derece);
            if (sonuc !== null) {
                const hedefInput = document.querySelector(`input[data-race="${i}"][data-horse="${j}"][data-col="ek_${window.ekSutunlar.indexOf(hedefSutunAdi)}"]`);
                if (hedefInput) {
                    hedefInput.value = sonuc;
                    hedefInput.style.backgroundColor = '#4CAF50';
                    hedefInput.style.color = '#000';
                    hesaplananSayi++;
                }
            }
        }
    }
    
    if (window.currentColName === hedefSutunAdi) {
        window.sutunFormulleri[hedefSutunAdi] = formulaMetni;
        const formulaInput = document.querySelector(`.col-formula-input[data-colname="${hedefSutunAdi}"]`);
        if (formulaInput) formulaInput.value = formulaMetni;
    }
    
    const fieldAdi = field === 'son800_bir' ? 'SON800-1' : 'SON800-2';
    document.getElementById('yonetimStatus').innerHTML = '<div class="status status-success">✅ ' + hesaplananSayi + ' at için ' + kosuNo + '. koşu ' + fieldAdi + ' değeri saliseye çevrildi! Formül kaydedildi.</div>';
}

function formulPaneliniOlustur() {
    if (!window.formulVerileri) return '<div class="status status-warning">⏳ Formüller yükleniyor...</div>';
    let html = '<div class="formula-panel"><div style="margin-bottom:10px;"><button class="add-col-btn" onclick="addColumn()">➕ Yeni Sütun Ekle</button></div>';
    html += '<div class="formula-help"><strong>📐 TEMEL FORMÜLLER:</strong>';
    for (let f of window.formulVerileri.temel_formuller) {
        html += `<span class="formula-tag" onclick="if(window.currentColName) insertFormula(window.currentColName, '${f.formul.replace('{sutun}', 'window.currentColName')}'); else alert('Önce bir sütuna tıklayın!')">${f.adi}</span>`;
    }
    html += '</div>';
    html += '<div class="formula-help" style="margin-top:8px;"><strong>⏱️ DÖNÜŞÜM FORMÜLLERİ:</strong>';
    for (let f of window.formulVerileri.donusum_formuller) {
        html += `<span class="formula-tag" onclick="if(window.currentColName) insertFormula(window.currentColName, '${f.formul.replace('{sutun}', 'window.currentColName')}'); else alert('Önce bir sütuna tıklayın!')">${f.adi}</span>`;
    }
    html += '</div>';
    html += '<div class="formula-help" style="margin-top:8px;"><strong>🎯 ÖZEL İŞLEMLER:</strong>';
    html += `<span class="formula-tag btn-special" onclick="if(window.currentColName) { cevirK1DereceToSalise(window.currentColName); } else alert('Önce bir sütuna tıklayın!')">📊 K1-DERECE → SALİSE</span>`;
    html += '</div>';
    html += dinamikKosuButonlariniOlustur();
    html += dinamikSon800ButonlariniOlustur();
    html += '<div class="formula-help" style="margin-top:8px;"><strong>🎨 RENKLENDİRME:</strong>';
    html += `<span class="formula-tag" onclick="if(window.currentColName){let esik=prompt('Eşik değeri girin (örn: 0.55)');if(esik) insertFormula(window.currentColName, '=ESIK('+esik+'; RENK(255;255;0))');} else alert('Önce bir sütuna tıklayın!')">EŞİK (sarı)</span>`;
    html += '</div>';
    html += '<div class="formula-help">💡 İpucu: Önce bir sütuna tıklayın, sonra formül seçin</div></div>';
    return html;
}

function cevirK1DereceToSalise(hedefSutunAdi) {
    if (!window.currentKarsilastirmaData) {
        document.getElementById('yonetimStatus').innerHTML = '<div class="status status-warning">⚠️ Önce bir Karşılaştırma kaydı yükleyin!</div>';
        return;
    }
    let cevrilenSayi = 0;
    for (let i = 0; i < window.currentKarsilastirmaData.length; i++) {
        const race = window.currentKarsilastirmaData[i];
        for (let j = 0; j < race.horses.length; j++) {
            const horse = race.horses[j];
            const dereceDegeri = getAtHesaplamaVerisi(horse.atId, 0, 'at_derece');
            if (dereceDegeri && dereceDegeri !== '-') {
                const saliseDegeri = dereceToSalise(dereceDegeri);
                if (saliseDegeri !== null) {
                    const hedefInput = document.querySelector(`input[data-race="${i}"][data-horse="${j}"][data-col="ek_${window.ekSutunlar.indexOf(hedefSutunAdi)}"]`);
                    if (hedefInput) {
                        hedefInput.value = saliseDegeri;
                        hedefInput.style.backgroundColor = '#4CAF50';
                        hedefInput.style.color = '#fff';
                        cevrilenSayi++;
                    }
                }
            }
        }
    }
    if (window.currentColName === hedefSutunAdi) {
        const formulaMetni = '=SALISE_CEVIR(K1-DERECE)';
        window.sutunFormulleri[hedefSutunAdi] = formulaMetni;
        const formulaInput = document.querySelector(`.col-formula-input[data-colname="${hedefSutunAdi}"]`);
        if (formulaInput) formulaInput.value = formulaMetni;
    }
    document.getElementById('yonetimStatus').innerHTML = '<div class="status status-success">✅ ' + cevrilenSayi + ' atın K1-DERECE değeri saliseye çevrildi! Formül kaydedildi.</div>';
}

function buildTable(){
    if(!window.currentKarsilastirmaData)return;
    let allCols=[...window.sutunlar,...window.hesaplamaKolons,...window.ekSutunlar];
    let html = formulPaneliniOlustur();
    for(let i=0;i<window.currentKarsilastirmaData.length;i++){
        let race=window.currentKarsilastirmaData[i];
        html+='<div class="race-card">';
        html+='<div class="race-header">🏆 '+race.raceNo+'. KOŞU ('+race.horseCount+' at)</div>';
        html+='<div style="overflow-x:auto;">';
        html+='<table border="0" cellpadding="5" cellspacing="0">';
        html+='<thead><tr>';
        for(let c=0;c<allCols.length;c++){
            let ch=allCols[c];
            let fi='';
            if(window.ekSutunlar.includes(ch)){
                let idx=window.ekSutunlar.indexOf(ch);
                let cf=window.sutunFormulleri[ch]||'';
                fi='<div><input type="text" class="col-formula-input" data-colname="'+ch+'" placeholder="=MIN('+ch+')" value="'+cf+'" style="width:100%;" onclick="window.currentColName=\''+ch+'\'; console.log(\'Seçilen sütun:\', window.currentColName)"></div>';
                ch=ch+' <button class="delete-col-btn" onclick="deleteColumn('+idx+')">✖</button>';
            }
            html+='<th>'+ch+fi+'</th>';
        }
        html+='</thead><tbody>';
        for(let j=0;j<race.horses.length;j++){
            let horse=race.horses[j];
            html+='<td>';
            html+='<td><input type="text" value="'+horse.sira+'" data-race="'+i+'" data-horse="'+j+'" data-col="sira" style="width:50px;"></td>';
            html+='<td><input type="text" value="'+escapeHtml(horse.atIsmi)+'" data-race="'+i+'" data-horse="'+j+'" data-col="atIsmi" style="min-width:120px;"></td>';
            html+='<td><input type="text" value="'+horse.atId+'" data-race="'+i+'" data-horse="'+j+'" data-col="atId" style="width:90px;"></td>';
            for(let h=0;h<window.hesaplamaKolons.length;h++){
                let kn=window.hesaplamaKolons[h];
                let d='';
                if(kn.includes('TARİH')){
                    let ki=parseInt(kn.split('-')[0].substring(1))-1;
                    d=getAtHesaplamaVerisi(horse.atId,ki,'tarih');
                }else if(kn.includes('MESAFE')){
                    let ki=parseInt(kn.split('-')[0].substring(1))-1;
                    d=getAtHesaplamaVerisi(horse.atId,ki,'mesafe');
                }else if(kn.includes('DERECE')){
                    let ki=parseInt(kn.split('-')[0].substring(1))-1;
                    d=getAtHesaplamaVerisi(horse.atId,ki,'at_derece');
                }else if(kn.includes('SON800-1')){
                    let ki=parseInt(kn.split('-')[0].substring(1))-1;
                    d=getAtHesaplamaVerisi(horse.atId,ki,'son800_bir');
                }else if(kn.includes('SON800-2')){
                    let ki=parseInt(kn.split('-')[0].substring(1))-1;
                    d=getAtHesaplamaVerisi(horse.atId,ki,'son800_iki');
                }
                html+='<td><input type="text" value="'+d+'" data-race="'+i+'" data-horse="'+j+'" data-col="hesap_'+h+'" style="width:80px;" readonly></td>';
            }
            for(let e=0;e<window.ekSutunlar.length;e++){
                html+='<td><input type="text" class="formula-input" placeholder="Değer girin" data-race="'+i+'" data-horse="'+j+'" data-col="ek_'+e+'" style="width:100px;"></td>';
            }
            html+='</tr>';
        }
        html+='</tbody><table></div></div><br>';
    }
    document.getElementById('yonetimResults').innerHTML=html;
    document.querySelectorAll('.col-formula-input').forEach(input=>{
        let colName=input.dataset.colname;
        input.onchange=()=>{window.sutunFormulleri[colName]=input.value;applyAllFormatting();};
    });
    document.querySelectorAll('input[data-col]').forEach(input=>{
        input.onchange=()=>{if(input.dataset.col.startsWith('ek_')){applyAllFormatting();}};
    });
}

document.getElementById('calismalariGetirBtn').onclick=async()=>{
    let sd=document.getElementById('yonetimStatus'),cld=document.getElementById('calismaListesi');
    sd.innerHTML='<div class="status status-loading">⏳ Kayıtlı çalışmalar yükleniyor...</div>';
    try{
        let resp=await fetch('/api/yonetim-calismalari-v2');
        let res=await resp.json();
        if(!res.success)throw new Error(res.error);
        if(res.calismalar.length===0){
            cld.innerHTML='<div class="empty">⚠️ Hiç kayıtlı çalışma bulunamadı.</div>';
            cld.style.display='block';
            sd.innerHTML='<div class="status status-error">⚠️ Hiç çalışma yok</div>';
            return;
        }
        let html='<div style="margin-bottom:10px; font-weight:bold;">📂 KAYITLI ÇALIŞMALARIM:</div>';
        for(let i=0;i<res.calismalar.length;i++){
            let c=res.calismalar[i];
            html+='<div class="kayit-item" data-id="'+c.id+'" data-ad="'+c.ad+'"><span>📝 '+c.ad+' | 📅 '+c.kayit_tarihi+'</span><span style="color:#4CAF50;">📂 Yükle →</span></div>';
        }
        cld.innerHTML=html;
        cld.style.display='block';
        document.getElementById('kayitListesi').style.display='none';
        document.querySelectorAll('#calismaListesi .kayit-item').forEach(item=>{
            item.onclick=async()=>{await loadCalisma(item.dataset.id);};
        });
        sd.innerHTML='<div class="status status-success">✅ '+res.calismalar.length+' çalışma bulundu.</div>';
    }catch(e){sd.innerHTML='<div class="status status-error">❌ Hata: '+e.message+'</div>';}
};

async function loadCalisma(id){
    let sd=document.getElementById('yonetimStatus');
    sd.innerHTML='<div class="status status-loading">⏳ Çalışma yükleniyor...</div>';
    try{
        let resp=await fetch('/api/yonetim-calisma-v2/'+id);
        let res=await resp.json();
        if(!res.success)throw new Error(res.error);
        
        window.currentKarsilastirmaId=res.calisma.karsilastirma_kayit_id;
        window.currentHesaplamaId=res.calisma.hesaplama_kayit_id;
        
        if(typeof res.calisma.sutun_yapisi==='string'){
            window.ekSutunlar=JSON.parse(res.calisma.sutun_yapisi||'[]');
        }else{
            window.ekSutunlar=res.calisma.sutun_yapisi||[];
        }
        
        if(typeof res.calisma.hesaplamalar==='string'){
            window.sutunFormulleri=JSON.parse(res.calisma.hesaplamalar||'{}');
        }else{
            window.sutunFormulleri=res.calisma.hesaplamalar||{};
        }
        
        console.log('📥 Yüklenen formüller:', window.sutunFormulleri);
        
        if(window.currentKarsilastirmaId){
            let karsResp=await fetch('/api/karsilastirma-kayit/'+window.currentKarsilastirmaId);
            let karsRes=await karsResp.json();
            if(karsRes.success){
                window.currentKarsilastirmaData=karsRes.kayit.siralama_veri;
                console.log('✅ Karşılaştırma kaydı yüklendi:', window.currentKarsilastirmaData.length+' koşu');
            }
        }
        
        if(window.currentHesaplamaId){
            let hesaplamaResp=await fetch('/api/hesaplama-kayit/'+window.currentHesaplamaId);
            let hesaplamaRes=await hesaplamaResp.json();
            if(hesaplamaRes.success){
                window.currentHesaplamaData=hesaplamaRes.kayit.veri;
                if(window.currentHesaplamaData && window.currentHesaplamaData[0] && window.currentHesaplamaData[0].horses){
                    let ilkAt=window.currentHesaplamaData[0].horses[0];
                    if(ilkAt && ilkAt.kosular){
                        window.mevcutKosuSayisi = ilkAt.kosular.length;
                        window.hesaplamaKolons=[];
                        for(let i=1;i<=window.mevcutKosuSayisi;i++){
                            window.hesaplamaKolons.push('K'+i+'-TARİH','K'+i+'-MESAFE','K'+i+'-DERECE','K'+i+'-SON800-1','K'+i+'-SON800-2');
                        }
                        console.log('📊 Koşu sayısı:', window.mevcutKosuSayisi);
                    }
                }
            }
        }
        
        buildTable();
        
        setTimeout(() => {
            console.log('🔄 Formüller uygulanıyor...', window.sutunFormulleri);
            let uygulanan = 0;
            for(let sutunAdi in window.sutunFormulleri) {
                if(window.sutunFormulleri[sutunAdi] && window.sutunFormulleri[sutunAdi].startsWith('=')) {
                    for(let i=0; i<window.currentKarsilastirmaData.length; i++) {
                        try {
                            applyColumnFormatting(sutunAdi, i);
                        } catch(e) { console.log('Hata:', sutunAdi, e); }
                    }
                    uygulanan++;
                    console.log('   Uygulandı:', sutunAdi, '=', window.sutunFormulleri[sutunAdi]);
                }
            }
            console.log('✅ ' + uygulanan + ' formül uygulandı!');
            if(uygulanan > 0) {
                sd.innerHTML='<div class="status status-success">✅ Çalışma yüklendi! ('+window.mevcutKosuSayisi+' koşu, ' + uygulanan + ' formül uygulandı)</div>';
            } else {
                sd.innerHTML='<div class="status status-success">✅ Çalışma yüklendi! ('+window.mevcutKosuSayisi+' koşu)</div>';
            }
        }, 800);
        
    }catch(e){
        console.error('loadCalisma hatası:',e);
        sd.innerHTML='<div class="status status-error">❌ Yükleme hatası: '+e.message+'</div>';
    }
}

document.getElementById('calismayiKaydetBtn').onclick=()=>{
    if(!window.currentKarsilastirmaData){
        document.getElementById('yonetimStatus').innerHTML='<div class="status status-error">❌ Önce bir KARŞILAŞTIRMA kaydı seçin veya EXCEL YÜKLE ile dosya yükleyin!</div>';
        return;
    }
    console.log('💾 Kaydedilecek formüller:', window.sutunFormulleri);
    document.getElementById('saveModal').style.display='block';
    document.getElementById('saveModalContent').style.display='block';
};

document.getElementById('saveModalClose').onclick=()=>{
    document.getElementById('saveModal').style.display='none';
    document.getElementById('saveModalContent').style.display='none';
};

document.getElementById('saveModalConfirm').onclick=async()=>{
    let ad=document.getElementById('calismaAdi').value;
    let aciklama=document.getElementById('calismaAciklama').value;
    if(!ad){document.getElementById('yonetimStatus').innerHTML='<div class="status status-error">❌ Lütfen bir çalışma adı girin!</div>';return;}
    document.getElementById('saveModal').style.display='none';
    document.getElementById('saveModalContent').style.display='none';
    document.getElementById('yonetimStatus').innerHTML='<div class="status status-loading">⏳ Çalışma kaydediliyor...</div>';
    console.log('📝 Kaydedilen ekSutunlar:', window.ekSutunlar);
    console.log('📝 Kaydedilen sutunFormulleri:', window.sutunFormulleri);
    let veri={
        ad:ad,
        aciklama:aciklama,
        karsilastirma_kayit_id:window.currentKarsilastirmaId,
        hesaplama_kayit_id:window.currentHesaplamaId,
        tablo_veri:window.currentKarsilastirmaData,
        sutun_yapisi:JSON.stringify(window.ekSutunlar),
        hesaplamalar:JSON.stringify(window.sutunFormulleri)
    };
    try{
        let resp=await fetch('/api/yonetim-calisma-kaydet-v2',{
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify(veri)
        });
        let res=await resp.json();
        if(res.success){
            document.getElementById('yonetimStatus').innerHTML='<div class="status status-success">✅ Çalışma kaydedildi! (ID: '+res.id+')</div>';
            document.getElementById('calismaAdi').value='';
            document.getElementById('calismaAciklama').value='';
        }else throw new Error(res.error);
    }catch(e){
        console.error('Kayıt hatası:', e);
        document.getElementById('yonetimStatus').innerHTML='<div class="status status-error">❌ Kayıt hatası: '+e.message+'</div>';
    }
};

function escapeHtml(s){if(!s)return '-';return s.replace(/[&<>]/g,function(m){return m==='&'?'&amp;':m==='<'?'&lt;':'&gt;';});}

window.addColumn=addColumn;
window.deleteColumn=deleteColumn;
window.insertFormula=insertFormula;
window.applyColumnFormatting=applyColumnFormatting;
window.applyAdvancedFormula=applyAdvancedFormula;
window.cevirK1DereceToSalise=cevirK1DereceToSalise;
window.hesaplaVeFormuluKaydet=hesaplaVeFormuluKaydet;
window.hesaplaVeSon800TekKaydet=hesaplaVeSon800TekKaydet;
window.getAtHesaplamaVerisi=getAtHesaplamaVerisi;
window.dereceToSalise=dereceToSalise;
window.metreBasinaSaliseHesapla=metreBasinaSaliseHesapla;
window.son800ToSalise=son800ToSalise;

formulleriYukle();
</script>
</body>
</html>
